<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>RealmOfThronesLauncher</RootNamespace>
    <AssemblyName>Coodsz Realm of Thrones Client Launcher</AssemblyName>
    <Product>Coodsz Realm of Thrones Client Launcher</Product>
    <AssemblyTitle>Coodsz Realm of Thrones Client Launcher</AssemblyTitle>
    <Description>Coodsz Realm of Thrones Client Launcher: sets up Realm of Thrones Coop and joins a server</Description>
    <ApplicationIcon>..\..\assets\icons\coodsz-rot-client.ico</ApplicationIcon>
    <Version>0.1.2</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RealmOfThrones.Core\RealmOfThrones.Core.csproj" />
    <ProjectReference Include="..\TaomCoop.Core\TaomCoop.Core.csproj" />
    <ProjectReference Include="..\BannerlordCoopLauncher.Core\BannerlordCoopLauncher.Core.csproj" />
  </ItemGroup>

  <!-- The ClientAddOns payload, embedded in the exe and written out on first use (CoodszPayload.targets, ToolPayload). -->
  <ItemGroup>
    <!-- Coodsz Join Password: sends the password on the first auto-connect without editing Coop.Core.dll; see
         compat\CoodszJoinPassword. Connect puts it in on every join (MainWindow.InstallJoinPassword). -->
    <CoodszPayload Include="..\..\compat\CoodszJoinPassword\module\**\*" Payload="ClientAddOns" PayloadFolder="DedicatedServer.CoodszJoinPassword\" />
  </ItemGroup>

  <!-- Realm of Thrones Coop Compat: Connect puts it in the game's Modules folder (InstallCompat). The server tool carries
       the same module folder. The module folder is the committed output of compat\RealmOfThronesCoopCompat\Build.cmd.
       A build without it fails, so no exe ships without the module. -->
  <PropertyGroup>
    <RotCompatModule>..\..\compat\RealmOfThronesCoopCompat\module</RotCompatModule>
  </PropertyGroup>

  <ItemGroup>
    <CoodszPayload Include="$(RotCompatModule)\**\*" Exclude="$(RotCompatModule)\README.txt" Payload="ClientAddOns" PayloadFolder="RealmOfThrones.CoopCompat\" />
  </ItemGroup>

  <Target Name="NeedRotCompat" BeforeTargets="BeforeBuild" Condition="!Exists('$(RotCompatModule)\SubModule.xml')">
    <Error Text="Realm of Thrones Coop Compat is not in compat\RealmOfThronesCoopCompat\module. Run compat\RealmOfThronesCoopCompat\Build.cmd first." />
  </Target>

  <ItemGroup>
    <!-- The Server Tool's dark stone picture behind the pages (Backdrop.Apply in App.xaml.cs). -->
    <Resource Include="..\RealmOfThronesHost\Assets\rot-backdrop-ember-green.jpg" Link="Assets\rot-backdrop-ember-green.jpg" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\BannerlordCoopLauncher\UiLanguage.cs" Link="UiLanguage.cs" />
    <Compile Include="..\BannerlordCoopLauncher\GameAlreadyOpen.cs" Link="GameAlreadyOpen.cs" />
    <Compile Include="..\BannerlordCoopLauncher\WindowPlacement.cs" Link="WindowPlacement.cs" />
    <Compile Include="..\BannerlordCoopLauncher\NewBadges.cs" Link="NewBadges.cs" />
    <Compile Include="..\BannerlordCoopLauncher\JoinGuideWindow.cs" Link="JoinGuideWindow.cs" />
    <Compile Include="..\BannerlordCoopLauncher\AntivirusWindow.cs" Link="AntivirusWindow.cs" />
    <Compile Include="..\BannerlordCoopLauncher\JoinCheckWindow.cs" Link="JoinCheckWindow.cs" />
    <!-- The Connect prompt when the server needs mods this PC does not have turned on. -->
    <Compile Include="..\BannerlordCoopLauncher\ServerModsWindow.cs" Link="ServerModsWindow.cs" />
    <!-- The Send my logs button (CrashReportUi) and what it needs. Nothing is sent until RotRelease.ReportsReady. -->
    <Compile Include="..\BannerlordCoopLauncher\ModReportWindow.cs" Link="ModReportWindow.cs" />
    <Compile Include="..\BannerlordCoopLauncher\CrashReportWindow.cs" Link="CrashReportWindow.cs" />
    <Compile Include="..\BannerlordCoopLauncher\ReportReplyWindow.cs" Link="ReportReplyWindow.cs" />
    <!-- Add mods uses the same picker as Coodsz Coop and Friends. -->
    <Compile Include="..\BannerlordCoopLauncher\CustomModWindow.cs" Link="CustomModWindow.cs" />
    <!-- The question before Connect sets another Coop aside, the same window as the TAOM launcher (CoopParking). -->
    <Compile Include="..\TaomCoopLauncher\SetAsideCoopWindow.cs" Link="SetAsideCoopWindow.cs" />
    <!-- Player text the server tool and this launcher share (what is off in the first version, the version note). -->
    <Compile Include="..\RealmOfThronesHost\RotUiText.cs" Link="RotUiText.cs" />
    <!-- The Guides page, the same one as in the TAOM and Burning Empires tools. -->
    <Compile Include="..\TaomCoopHost\TaomGuidesPage.cs" Link="TaomGuidesPage.cs" />
  </ItemGroup>

  <!-- The RoT build of Coop this exe carries (RotStack.CoopBuild, src\RotCoopBuild.targets): the client zip. -->
  <PropertyGroup>
    <CoodszRotCoopClientName>Coop-RoT-Client-2026-11-14-01846e1.zip</CoodszRotCoopClientName>
    <CoodszRotCoopClientSha256>FBC78E7B8594B2F2E2644FA6EB35ED28972B1CE934898D27CBB18E28DB1E908F</CoodszRotCoopClientSha256>
  </PropertyGroup>

  <Import Project="..\RotCoopBuild.targets" />
  <Import Project="..\CoodszPayload.targets" />

  <!-- The shared window frame (sidebar, header, chips, banners) and the Keep look it uses: docs/design/redesign/build-plan.md 1.1. -->
  <!-- App.xaml merges the two Keep files (redesign wave 7). -->
  <ItemGroup>
    <!-- The Realm of Thrones colours from the Server Tool (black, green and red), under the shared file's name. -->
    <Page Include="..\RealmOfThronesHost\Keep\KeepColors.Rot.xaml" Link="Keep\KeepColors.xaml" />
    <Page Include="..\CoodszHost\Keep\KeepTheme.xaml" Link="Keep\KeepTheme.xaml" />
    <Page Include="..\CoodszHost\Shared\Frame\*.xaml" Link="Shared\Frame\%(Filename)%(Extension)" />
    <Compile Include="..\CoodszHost\Shared\Frame\*.cs" Link="Shared\Frame\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
