<Window x:Class="BurningEmpiresHost.ConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirm" SizeToContent="WidthAndHeight" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" WindowStyle="None" ShowInTaskbar="False"
        Background="Transparent" AllowsTransparency="True" FontFamily="Segoe UI"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <ControlTemplate x:Key="HoverButton" TargetType="Button">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                <Grid>
                    <Border x:Name="Hover" Background="#33F6EDE0" BorderBrush="#FF8C7355" BorderThickness="2" Opacity="0" IsHitTestVisible="False"/>
                    <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsMouseOver" Value="True"/>
                        <Condition Property="IsEnabled" Value="True"/>
                    </MultiTrigger.Conditions>
                    <Setter TargetName="Hover" Property="Opacity" Value="1"/>
                </MultiTrigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
    </Window.Resources>
    <Border x:Name="Frame" Background="#FF101214" BorderBrush="#FF5C6058" BorderThickness="1" Padding="22" Width="460">
        <!-- The list or details row takes what is left. WindowPlacement caps the box at the screen height, so on a
             small or scaled screen the details get shorter and scroll, and the Cancel and OK row stays on screen. -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock x:Name="TitleBlock" FontFamily="Palatino Linotype" FontSize="22" Foreground="#FF8FBF86" TextWrapping="Wrap" Margin="0,0,28,0"/>
            <Button Grid.Row="0" Content="&#x00D7;" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Width="28" Height="28" Padding="0" Margin="0,-6,-6,0" Cursor="Hand" FontSize="18"
                    Background="Transparent" Foreground="#FF7DAAA4" BorderThickness="0"
                    Template="{StaticResource HoverButton}" Click="Cancel_Click" ToolTip="Cancel"/>
            <TextBlock x:Name="BodyBlock" Grid.Row="1" FontSize="16" Foreground="#FFE8E6E1" TextWrapping="Wrap" Margin="0,14,0,0"/>
            <!-- AskList: a tidy list of names with a small note and a warning line under it. -->
            <StackPanel x:Name="ListPanel" Grid.Row="2" Visibility="Collapsed" Margin="0,12,0,0">
                <Border Background="#FF16181C" BorderBrush="#FF4A4E54" BorderThickness="1" Padding="12,8">
                    <StackPanel x:Name="ListItems"/>
                </Border>
                <TextBlock x:Name="NoteBlock" FontSize="13" Foreground="#FF7DAAA4" TextWrapping="Wrap" Margin="0,12,0,0"/>
                <TextBlock x:Name="WarnBlock" FontSize="13" Foreground="#FFD2A36A" TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>
            <TextBox x:Name="DetailsBox" Grid.Row="2" Visibility="Collapsed" IsReadOnly="True" TextWrapping="Wrap" MinHeight="90" MaxHeight="320" Margin="0,14,0,0" Padding="8"
                     VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" Background="#FF16181C" Foreground="#FFD5DEE6" BorderBrush="#FF4A4E54"/>
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button x:Name="CancelButton" Content="Cancel" ToolTip="Closes this box without doing anything." Padding="16,8" Cursor="Hand" FontFamily="Segoe UI" FontSize="15"
                        Background="#CC16181C" Foreground="#FFE8E6E1" BorderBrush="#FF4A4E54" BorderThickness="1"
                        Template="{StaticResource HoverButton}" Click="Cancel_Click"/>
                <Button x:Name="OkButton" Content="OK" ToolTip="Goes ahead with what this box describes." Margin="8,0,0,0" Padding="18,8" Cursor="Hand" FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="15"
                        Background="#FF314236" Foreground="#FFE8E6E1" BorderBrush="#FF5C6A56" BorderThickness="1"
                        Template="{StaticResource HoverButton}" Click="Ok_Click" IsDefault="True"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
