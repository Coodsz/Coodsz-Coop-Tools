<Window x:Class="CoodszHost.ConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirm" SizeToContent="WidthAndHeight" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" WindowStyle="None" ShowInTaskbar="False"
        Background="Transparent" AllowsTransparency="True" FontFamily="Segoe UI"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <ControlTemplate x:Key="HoverButton" TargetType="Button">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                <Grid>
                    <Border x:Name="Hover" Background="#33F6EDE0" BorderBrush="#FF8EB4D4" BorderThickness="2" Opacity="0" IsHitTestVisible="False"/>
                    <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsMouseOver" Value="True"/>
                        <Condition Property="IsEnabled" Value="True"/>
                    </MultiTrigger.Conditions>
                    <Setter TargetName="Hover" Property="Opacity" Value="1"/>
                </MultiTrigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
    </Window.Resources>
    <Border x:Name="Frame" Background="#FF10161B" BorderBrush="#FF3A4C5C" BorderThickness="1" Padding="22" Width="460">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock x:Name="TitleBlock" FontFamily="Segoe UI" FontSize="22" FontWeight="SemiBold" Foreground="#FFE2C27A" TextWrapping="Wrap" Margin="0,0,28,0"/>
            <Button Grid.Row="0" Content="&#x00D7;" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Width="28" Height="28" Padding="0" Margin="0,-6,-6,0" Cursor="Hand" FontSize="18"
                    Background="Transparent" Foreground="#FF8EA0AE" BorderThickness="0"
                    Template="{StaticResource HoverButton}" Click="Cancel_Click" ToolTip="Cancel"/>
            <TextBlock x:Name="BodyBlock" Grid.Row="1" FontSize="16" Foreground="#FFD5DEE6" TextWrapping="Wrap" Margin="0,14,0,0"/>
            <!-- AskList: a tidy list of names with a small note and a warning line under it. -->
            <StackPanel x:Name="ListPanel" Grid.Row="2" Visibility="Collapsed" Margin="0,12,0,0">
                <Border Background="#FF0B1014" BorderBrush="#FF3A4C5C" BorderThickness="1" Padding="12,8">
                    <StackPanel x:Name="ListItems"/>
                </Border>
                <TextBlock x:Name="NoteBlock" FontSize="13" Foreground="#FF8EA0AE" TextWrapping="Wrap" Margin="0,12,0,0"/>
                <TextBlock x:Name="WarnBlock" FontSize="13" Foreground="#FFD2A36A" TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>
            <TextBox x:Name="DetailsBox" Grid.Row="2" Visibility="Collapsed" Margin="0,14,0,0" Height="380" IsReadOnly="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" FontFamily="Consolas" FontSize="13" Padding="8"
                     Background="#FF0B1014" Foreground="#FFD5DEE6" BorderBrush="#FF3A4C5C" BorderThickness="1"/>
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button x:Name="CancelButton" Content="Cancel" ToolTip="Closes this box without doing anything." Padding="16,8" Cursor="Hand" FontFamily="Segoe UI" FontSize="15"
                        Background="#FF1B2833" Foreground="#FFD5DEE6" BorderBrush="#FF3A4C5C" BorderThickness="1"
                        Template="{StaticResource HoverButton}" Click="Cancel_Click"/>
                <Button x:Name="OkButton" Content="OK" ToolTip="Goes ahead with what this box describes." Margin="8,0,0,0" Padding="18,8" Cursor="Hand" FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="15"
                        Background="#FF1F4E79" Foreground="#FFD5DEE6" BorderBrush="#FF8EB4D4" BorderThickness="1"
                        Template="{StaticResource HoverButton}" Click="Ok_Click" IsDefault="True"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
