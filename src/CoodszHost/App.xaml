<Application x:Class="CoodszHost.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- The look of the Cheats page, the player profile and the Items window (keys start with Keep.): the colours first, then the styles that use them. -->
                <ResourceDictionary Source="Keep/KeepColors.xaml"/>
                <ResourceDictionary Source="Keep/KeepTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="ComboBox">
                <Setter Property="Foreground" Value="#FFF4E7CC"/>
                <Setter Property="Background" Value="#FF100E0C"/>
                <Setter Property="BorderBrush" Value="#FFC4A574"/>
                <Setter Property="Padding" Value="8,4"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
            </Style>
            <!-- Every hover tip in this tool is a dark card in the Coodsz Host colours, wrapped at 320. -->
            <Style TargetType="ToolTip">
                <Setter Property="Foreground" Value="#FFD5DEE6"/>
                <Setter Property="Background" Value="#FF151D24"/>
                <Setter Property="BorderBrush" Value="#FF3A4C5C"/>
                <Setter Property="FontFamily" Value="Segoe UI"/>
                <Setter Property="FontSize" Value="12.5"/>
                <Setter Property="HasDropShadow" Value="True"/>
                <Setter Property="FlowDirection" Value="{Binding PlacementTarget.FlowDirection, RelativeSource={RelativeSource Self}}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToolTip">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10,7" MaxWidth="320">
                                <ContentPresenter>
                                    <ContentPresenter.Resources>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextWrapping" Value="Wrap"/>
                                        </Style>
                                    </ContentPresenter.Resources>
                                </ContentPresenter>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
