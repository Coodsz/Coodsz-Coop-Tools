                                                <TextBox x:Name="RealmRewardCodeBox" IsReadOnly="True" FontFamily="Consolas" FontSize="17" FontWeight="Bold" Foreground="#FFE2C27A" Background="#FF08170F" BorderBrush="#FF3F7A52" BorderThickness="1" Padding="8,5" VerticalContentAlignment="Center"/>
                                                <Border x:Name="RealmRewardMask" Background="#FF08170F" BorderBrush="#FF3F7A52" BorderThickness="1" Visibility="Collapsed" ToolTip="Hidden by streamer mode. Copy code still copies it.">
                                                    <TextBlock Text="•••••• hidden by streamer mode" Foreground="#FFBCD6C3" VerticalAlignment="Center" Margin="8,0"/>
                                                </Border>
                                            </Grid>
                                        </DockPanel>
                                        <TextBlock x:Name="RealmRewardHint" FontSize="13" Foreground="#FFBCD6C3" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>
                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <Button x:Name="RealmJoinButton" ToolTip="Opens the invite to The Realm Discord in your browser." Content="Join The Realm on Discord" Click="RealmJoin_Click" Cursor="Hand" Padding="24,12" FontSize="17" FontWeight="Bold" Foreground="#FFFFFFFF" BorderBrush="#FF9FE0B0" BorderThickness="1">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="B" CornerRadius="6" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                                                    <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop x:Name="Top" Color="#FF3F8F57" Offset="0"/><GradientStop Color="#FF23663A" Offset="1"/></LinearGradientBrush></Border.Background>
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="#FFE2C27A"/></Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <Button Style="{StaticResource Ghost}" Content="Copy invite link" Click="RealmCopy_Click" ToolTip="Copies the invite link to The Realm Discord." Margin="10,0,0,0" Padding="16,10" Cursor="Hand"/>
                                </StackPanel>
                                <TextBlock x:Name="RealmStatus" FontSize="13" Foreground="#FFBCD6C3" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                <Border Margin="0,22,0,0" Padding="14,10" CornerRadius="8" Background="#990A1A11" BorderBrush="#FF3F7A52" BorderThickness="1" MaxWidth="640" HorizontalAlignment="Left">
                                    <StackPanel>
                                        <TextBlock Text="For Realm staff: check a reward code" FontSize="14" FontWeight="SemiBold" Foreground="#FFE2C27A"/>
                                        <TextBlock Text="Paste the code from the ticket. It shows whether the code is real and which Steam account it belongs to. Each Steam account has one code, so search the ticket history for the same code to catch a second claim." FontSize="13" Foreground="#FFBCD6C3" TextWrapping="Wrap" Margin="0,2,0,6"/>
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Content="Check" Click="RealmCheck_Click" ToolTip="Checks if the pasted reward code is real and shows which Steam account it belongs to." Margin="8,0,0,0" Padding="16,6" Cursor="Hand"/>
                                            <TextBox x:Name="RealmCheckBox" FontFamily="Consolas" FontSize="15" Padding="8,5" Background="#FF08170F" Foreground="#FFE6EFE8" BorderBrush="#FF3F7A52" BorderThickness="1" VerticalContentAlignment="Center"/>
                                        </DockPanel>
                                        <DockPanel Margin="0,6,0,0">
                                            <Button x:Name="RealmProfileButton" ToolTip="Opens the Steam profile of the account that owns the checked code." DockPanel.Dock="Right" Style="{StaticResource Ghost}" Content="Open Steam profile" Click="RealmProfile_Click" Margin="8,0,0,0" Padding="12,5" Cursor="Hand" Visibility="Collapsed"/>
                                            <TextBlock x:Name="RealmCheckResult" FontSize="14" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="#FFE6EFE8"/>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </DockPanel>
                    </Grid>
                </ScrollViewer>
                <Grid x:Name="ModulesPage" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Margin="0,0,0,12" Padding="14,12" CornerRadius="6" Background="#F0151D24" BorderBrush="#FF3A4C5C" BorderThickness="1">
                        <Border.Resources>
                            <Style x:Key="BarPrimary" TargetType="Button" BasedOn="{StaticResource Keep.BtnPrimary}">
                                <Setter Property="Margin" Value="0,0,8,8"/>
                            </Style>
                            <Style x:Key="BarGhost" TargetType="Button" BasedOn="{StaticResource Keep.BtnGhost}">
                                <Setter Property="Margin" Value="0,0,8,8"/>
                            </Style>
                            <!-- A notice line inside the page (the save hint), the look of a Warn banner. -->
                            <Style x:Key="ModsWarnLine" TargetType="Border">
                                <Setter Property="Margin" Value="0,0,0,8"/>
                                <Setter Property="Padding" Value="12,8"/>
                                <Setter Property="CornerRadius" Value="8"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="Background" Value="{StaticResource Keep.WarningSoft}"/>
                                <Setter Property="BorderBrush" Value="{StaticResource Keep.GoldInk}"/>
                            </Style>
                        </Border.Resources>
                        <!-- The top of the page scrolls on its own once it would take more than half the page, so the list keeps room (StartModsPage). -->
                        <ScrollViewer x:Name="ModsTopScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                        <StackPanel>
                            <!-- One line: the Active Coop strip (which Coop the server loads and where it comes from), then the count. Its hover says players need the same mods. The page title is in the header. -->
                            <DockPanel Margin="0,0,0,8">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <Border ToolTip="Players need the same mods at the same versions to join." VerticalAlignment="Center" Margin="0,0,0,0" Padding="12,3" CornerRadius="12" Background="#FF163028" BorderBrush="#FF8FCB9B" BorderThickness="1">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="ModuleSummaryText" FontSize="16" FontWeight="Bold" Foreground="#FFB6E7C2" VerticalAlignment="Center"/>
                                            <TextBlock Text="mods on" FontSize="14" FontWeight="SemiBold" Foreground="#FFB6E7C2" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <Border Padding="14,6" CornerRadius="8" Background="#FF10161B" BorderBrush="#FF2A3844" BorderThickness="1" VerticalAlignment="Center">
                                    <StackPanel>
                                        <TextBlock x:Name="ActiveCoop" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                        <!-- The game's Modules\Coop is newer than the server's Coop (CoopInstall.ServerBehindLine): the server needs Coop's own server download (Download Coop server, then Set server folder). -->
                                        <DockPanel x:Name="CoopBehindLine" Visibility="Collapsed" Margin="0,6,0,2">
                                            <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Content="Set server folder" Click="SetServerFolder_Click" Margin="12,0,0,0" VerticalAlignment="Center" ToolTip="Chooses which BannerlordCoopServer.exe this tool starts."/>
                                            <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Content="Download Coop server" Click="DownloadCoopServer_Click" Margin="12,0,0,0" VerticalAlignment="Center" ToolTip="Opens the Coop dedicated server download (about 4.5 GB) in your browser. It is linked at the bottom of Coop's release notes, not under Assets."/>
                                            <TextBlock x:Name="CoopBehindText" TextWrapping="Wrap" FontSize="13" FontWeight="SemiBold" Foreground="#FFE2C27A" VerticalAlignment="Center"/>
                                        </DockPanel>
                                        <!-- The server folder the host chose has an older Coop than the Workshop server (CoopInstall.ChosenServerOlderLine): Use the Steam server goes back to it. -->
                                        <DockPanel x:Name="SteamServerLine" Visibility="Collapsed" Margin="0,6,0,2">
                                            <Button x:Name="UseSteamServerButton" DockPanel.Dock="Right" Style="{StaticResource Ghost}" Content="Use the Steam server" Click="UseSteamServer_Click" Margin="12,0,0,0" VerticalAlignment="Center" AutomationProperties.AutomationId="UseSteamServer" ToolTip="The tool uses the Steam Workshop Coop server again. Your picked folder stays on disk."/>
                                            <TextBlock x:Name="SteamServerText" TextWrapping="Wrap" FontSize="13" FontWeight="SemiBold" Foreground="#FFE2C27A" VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>
                            </DockPanel>
                            <!-- One notice at a time: the running block (ApplyModListBlock) beats the save hint, which hides while it shows. -->
                            <ui:Banner x:Name="ModsRunningBanner" Kind="Warn" Visibility="Collapsed" Margin="0,0,0,8"/>
                            <Border>
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource ModsWarnLine}">
                                        <Setter Property="Visibility" Value="{Binding Visibility, ElementName=ModuleSaveHint}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Visibility, ElementName=ModsRunningBanner}" Value="Visible">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock x:Name="ModuleSaveHint" Visibility="Collapsed" TextWrapping="Wrap" Margin="0,4,0,0" FontSize="14" FontWeight="SemiBold" Foreground="#FFE2C27A" Text="Please save to keep these changes. Click Save module config, then restart the server."/>
                            </Border>
                            <WrapPanel x:Name="ModuleToolbar">
                                <Button x:Name="AddModsButton" Style="{StaticResource Keep.BtnGold}" Content="Add mods" Click="AddMods_Click" Margin="0,0,8,8" ToolTip="Finds Steam Workshop mods and Nexus or ModDB mods already installed in Bannerlord, then copies them into the server Modules folder."/>
                                <Button x:Name="SaveModulesButton" Style="{StaticResource BarPrimary}" Content="Save module config" Click="SaveModules_Click" ToolTip="Writes which modules are on, and their load order, into this profile. Locked setups already have that saved."/>
                                <Button x:Name="RefreshModulesButton" Style="{StaticResource BarGhost}" Content="Refresh" Click="ReloadModules_Click" ToolTip="Reads the Modules folder again after you add or remove a mod, and updates mods that have a newer version on Steam or in your game's Modules folder. Locked setups do not use this."/>
                                <Button x:Name="EnabledOnly" Style="{StaticResource BarGhost}" Content="Enabled only" Click="EnabledOnly_Click" ToolTip="Hides modules that are turned off. It does not change the server list. Click again to show every module."/>
                                <Button x:Name="ModsMoreButton" Style="{StaticResource BarGhost}" Content="More ▾" Click="ModsMore_Click" ToolTip="Share mod list, Import mod list, Auto dependency order and Test mods on the server.">
                                    <Button.ContextMenu>
                                        <ContextMenu Style="{StaticResource Keep.Menu}">
                                            <MenuItem Header="Share mod list" Click="ShareList_Click" ToolTip="Shows where to save the file, then saves coodsz-mod-list.json. The Desktop is fine."/>
                                            <MenuItem x:Name="ImportListItem" Header="Import mod list" Click="OpenSharedList_Click" ToolTip="Pick a coodsz-mod-list.json file. Extra mods match the file. Click Save module config after that."/>
                                            <MenuItem x:Name="AutoOrderButton" Header="Auto dependency order" Click="AutoOrder_Click" ToolTip="Sorts extra mods below the working Coop list. It does not move the mods that make the map and coop run. Locked setups leave this off."/>
                                            <MenuItem x:Name="TestModsButton" Header="Test mods on the server" Click="TestMods_Click" ToolTip="Starts the server once per mod on this PC that is not in the working list, with the working list core plus that mod, on a throwaway campaign. Your saves are not touched."/>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                                <TextBlock x:Name="FullModListLink" FontSize="15" VerticalAlignment="Center" Margin="4,0,0,8" ToolTip="Opens the Coop and Friends mod list on GitHub in your browser: every mod with its status, player reports and notes.">
                                    <Hyperlink Click="FullModList_Click" Foreground="#FFE8E6E1" TextDecorations="Underline"><Run x:Name="FullModListText" Text="Full mod list"/></Hyperlink>
                                </TextBlock>
                            </WrapPanel>
                            <!-- Filter chips (Coodsz Host only), after the community list badges. -->
                            <WrapPanel x:Name="ModFilterChips" Margin="0,2,0,0" Visibility="Collapsed"/>
                            <!-- The order rule in one short line, the reasons on Why?. It hides while the save hint above has something to say. -->
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Visibility, ElementName=ModuleSaveHint}" Value="Visible">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock x:Name="ModulesIntro" Text="Keep the Coop mods in this order. Extra mods go below." Foreground="#FF8EA0AE" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="40"
                                           ToolTip="The working Coop mods load in the order that runs. Moving them, or putting another mod between them, can break the map and the game. The number beside a name is its load position. Bannerlord Coop can move on a normal setup, and it can be turned off. Locked setups stay as they are."/>
                                <TextBlock Text="Why?" Margin="8,0,0,0" Foreground="#FFE2C27A" TextDecorations="Underline" Cursor="Help" ToolTip="The working Coop mods load in the order that runs. Moving them, or putting another mod between them, can break the map and the game. The number beside a name is its load position. Bannerlord Coop can move on a normal setup, and it can be turned off. Locked setups stay as they are."/>
                            </StackPanel>
                            <TextBlock x:Name="DependencyNote" Foreground="#FF8EA0AE" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="60" Margin="0,4,0,0" Visibility="Collapsed" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                            <TextBlock x:Name="ModuleRefreshStatus" Visibility="Collapsed" TextWrapping="Wrap" Margin="0,4,0,0" FontSize="14" FontWeight="SemiBold" Foreground="#FFE2C27A"/>
                        </StackPanel>
                        </ScrollViewer>
                    </Border>
                    <!-- Alt+Up and Alt+Down move the focused row, Space turns it on or off (ModuleListKeys). -->
                    <ListBox x:Name="ModuleList" Grid.Row="1" Background="Transparent" BorderThickness="0" Foreground="#FFD5DEE6"
                             HorizontalContentAlignment="Stretch" VirtualizingPanel.IsVirtualizing="False" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             PreviewKeyDown="ModuleListKeys"
                             PreviewMouseLeftButtonDown="ModuleDragStart" PreviewMouseMove="ModuleDragMove" PreviewMouseLeftButtonUp="ModuleDragUp" LostMouseCapture="ModuleDragUp"
                             ItemContainerStyle="{StaticResource Keep.ModRowItem}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="RowEdge" BorderBrush="#FF2A3844" BorderThickness="1" Background="#F0151D24" CornerRadius="6" Padding="10,6" Cursor="SizeNS" MinHeight="{x:Static ui:ModRowLayout.RowHeight}">
                                    <Grid VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36"/>
                                            <ColumnDefinition Width="*" MinWidth="120"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="OrderLabel" Grid.Column="0" Text="{Binding Order}" VerticalAlignment="Center" Foreground="#FFE2C27A" FontFamily="Consolas" FontWeight="SemiBold" FontSize="14"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock x:Name="ModName" Text="{Binding Name}" FontWeight="SemiBold" Foreground="#FFD5DEE6" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                                            <TextBlock Text="{Binding IdLine}" Foreground="#FF8EA0AE" FontFamily="Consolas" FontSize="11.5" TextTrimming="CharacterEllipsis" ToolTip="{Binding IdLine}" Tag="coodsz:no-translate"/>
                                        </StackPanel>
                                        <!-- One fixed badge column, so the chips line up on every row: this PC's result or New, then Always on,
                                             Coodsz module or Bundled, then the community badge (at most 3, ModChips). Under them the report chips and the Report link. -->
                                        <StackPanel Grid.Column="2" Width="{x:Static ui:ModRowLayout.ChipColumn}" VerticalAlignment="Center">
                                        <!-- The chips wrap to a second line when long words (Russian, Arabic) do not fit the column. -->
                                        <WrapPanel>
                                        <Border DockPanel.Dock="Left" CornerRadius="9" Padding="8,1" Margin="0,0,6,0" MaxWidth="130" VerticalAlignment="Center" ToolTip="{Binding Mine.Hover}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#FF1E3326"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Mine}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsNew}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Mine.Good}" Value="False">
                                                            <Setter Property="Background" Value="#FF3A2422"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Mine.Older}" Value="True">
                                                            <Setter Property="Opacity" Value="0.5"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Mine.Text}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#FF8FCB9B"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Mine.Good}" Value="False">
                                                                <Setter Property="Foreground" Value="#FFE08B84"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                        <ItemsControl DockPanel.Dock="Left" ItemsSource="{Binding Chips}" Focusable="False" IsTabStop="False" VerticalAlignment="Center">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <ui:Chip Text="{Binding Text}" Kind="{Binding KindName}" Tip="{Binding Tip}" MaxWidth="130" Margin="0,0,6,0"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Button DockPanel.Dock="Left" Click="CompatBadge_Click" Cursor="Hand" Margin="0,0,0,0" VerticalAlignment="Center" ToolTip="{Binding Compat.Tip}">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Compat}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Pill" CornerRadius="9" Padding="8,1" Background="#FF24303A" MaxWidth="130">
                                                        <TextBlock x:Name="Label" Text="{Binding Compat.Text}" FontSize="11" FontWeight="SemiBold" Foreground="#FF8EA0AE" TextTrimming="CharacterEllipsis"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding Compat.Kind}" Value="Works">
                                                            <Setter TargetName="Pill" Property="Background" Value="#FF1E3326"/>
                                                            <Setter TargetName="Label" Property="Foreground" Value="#FF8FCB9B"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Compat.Kind}" Value="ClientOnly">
                                                            <Setter TargetName="Pill" Property="Background" Value="#FF1C2A3A"/>
                                                            <Setter TargetName="Label" Property="Foreground" Value="#FF8EB4D4"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Compat.Kind}" Value="Broken">
                                                            <Setter TargetName="Pill" Property="Background" Value="#FF3A2422"/>
                                                            <Setter TargetName="Label" Property="Foreground" Value="#FFE08B84"/>
                                                        </DataTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        </WrapPanel>
                                        <!-- What players reported (ModReportUi.CountChips) and the small Report link (ModReportUi.RowLink), built in MainWindow.ReportChips. -->
                                        <ContentControl Content="{Binding Reports}" HorizontalAlignment="Left" Focusable="False" IsTabStop="False"/>
                                        </StackPanel>
                                        <ui:MoveButtons Grid.Column="3" Margin="8,0,0,0" VerticalAlignment="Center" ItemName="{Binding Name}" CanMoveUp="{Binding CanMove}" CanMoveDown="{Binding CanMove}" MoveUp="ModuleMoveUp" MoveDown="ModuleMoveDown"/>
                                        <Button Grid.Column="4" Content="Delete" Click="DeleteModule_Click" Cursor="Hand" Margin="8,0,0,0" Padding="10,3" FontSize="11" VerticalAlignment="Center"
                                                Background="#FF3A1F22" Foreground="#FFF0B4AE" BorderBrush="#FF8A4A4A" BorderThickness="1"
                                                ToolTip="Takes this mod out of the dedicated server. The folder moves to DedicatedServer\removed-mods, so it can be put back.">
                                            <Button.Style>
                                                <!-- Hidden, not Collapsed: a row without Delete keeps the slot, so the arrows and
                                                     the switch sit at the same place on every row (ModRowLayout). While hidden it is
                                                     also off and out of UI Automation; it works only when the row can be deleted and moved. -->
                                                <Style TargetType="Button">
                                                    <Setter Property="Visibility" Value="Hidden"/>
                                                    <Setter Property="IsEnabled" Value="False"/>
                                                    <Setter Property="AutomationProperties.IsOffscreenBehavior" Value="Offscreen"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CanDelete}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Setter Property="AutomationProperties.IsOffscreenBehavior" Value="Default"/>
                                                        </DataTrigger>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding CanDelete}" Value="True"/>
                                                                <Condition Binding="{Binding CanMove}" Value="True"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="IsEnabled" Value="True"/>
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <CheckBox Grid.Column="5" Style="{StaticResource Keep.Switch}" IsChecked="{Binding Enabled, Mode=TwoWay}" IsEnabled="{Binding CanToggle}" Margin="12,0,2,0" ToolTip="On loads this mod on the server. Always on mods stay on." Click="ModuleSwitch_Click"/>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding CanMove}" Value="False">
                                        <Setter TargetName="RowEdge" Property="Cursor" Value="Arrow"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsNew}" Value="True">
                                        <Setter TargetName="RowEdge" Property="Background" Value="#FF3A3420"/>
                                        <Setter TargetName="RowEdge" Property="BorderBrush" Value="#FFE2C27A"/>
                                        <Setter TargetName="RowEdge" Property="BorderThickness" Value="2"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsDragging}" Value="True">
                                        <Setter TargetName="RowEdge" Property="Background" Value="#FFE2C27A"/>
                                        <Setter TargetName="RowEdge" Property="BorderBrush" Value="#FFE2C27A"/>
                                        <Setter TargetName="RowEdge" Property="BorderThickness" Value="2"/>
                                        <Setter TargetName="OrderLabel" Property="Foreground" Value="#FF1A160C"/>
                                        <Setter TargetName="ModName" Property="Foreground" Value="#FF1A160C"/>
                                        <Setter TargetName="ModName" Property="FontWeight" Value="Bold"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
                <Grid x:Name="SettingsPage" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border x:Name="SettingsSaveBanner" Margin="0,0,0,12" Padding="16,14" CornerRadius="6" Background="#FF151D24" BorderBrush="#FF3A4C5C" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock x:Name="SettingsSavePrompt" Text="Finish your changes" FontSize="18" FontWeight="SemiBold" Foreground="#FF8EA0AE" TextWrapping="Wrap"/>
                                <TextBlock x:Name="SettingsSaveDetail" Text="Save settings writes this page. The running server keeps its current values until you restart it." FontSize="16" FontWeight="SemiBold" Foreground="#FFFFFFFF" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                <TextBlock x:Name="SettingsNote" FontSize="16" FontWeight="SemiBold" Foreground="#FFFFFFFF" Margin="0,6,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="SaveSettingsButton" ToolTip="Writes everything on this page to the server settings files. A running server keeps the old values until you restart it." Style="{StaticResource Primary}" Content="Save settings" Click="SaveSettingsPage_Click" Margin="0" Padding="18,10" FontSize="15"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" RequestBringIntoView="KeepDropdownSelection">
                    <StackPanel>
                        <!-- Join: how friends reach the server (from the old Server page, masks included). Region saves when it changes,
                             the address when you leave the box, the password and Steam advertise with Save settings. -->
                        <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,12">
                            <StackPanel>
                            <TextBlock Text="Join" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="280"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="Engine port" Foreground="#FF8EA0AE" VerticalAlignment="Center" Margin="0,8,0,0"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="EnginePortBox" ToolTip="The port the dedicated server program uses inside your PC. It is locked and friends never type it." Height="34" Margin="0,8,0,0" Padding="8,0" VerticalContentAlignment="Center" Text="7210" IsReadOnly="True"/>
                                    <TextBlock Grid.Row="0" Grid.Column="2" Margin="12,8,0,0" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#FF8EA0AE" Text="Dedicated server program only. Friends do not type this."/>
                                    <TextBlock Grid.Row="1" Text="Region" Foreground="#FF8EA0AE" VerticalAlignment="Center" Margin="0,8,0,0"/>
                                    <ComboBox Grid.Row="1" Grid.Column="1" x:Name="RegionBox" ToolTip="Picks the area Steam lobby joins use. Restart the server after you change it." Style="{StaticResource DifficultyBox}" Height="34" Margin="0,8,0,0" VerticalAlignment="Center" RequestBringIntoView="KeepDropdownSelection" SelectionChanged="Region_Changed"/>
                                    <TextBlock Grid.Row="1" Grid.Column="2" Margin="12,8,0,0" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#FF8EA0AE" Text="Steam lobby joins use this area. EU, NA, AS, OC, SA, or AF. A direct address and the UDP port ignore it. Restart the server after you change it."/>
                                    <TextBlock Grid.Row="2" Text="Server address" Foreground="#FF8EA0AE" VerticalAlignment="Center" Margin="0,8,0,0"/>
                                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="ServerAddressBox" Height="34" Margin="0,8,0,0" Padding="8,0" VerticalContentAlignment="Center" IsReadOnly="False" LostFocus="ServerAddress_LostFocus"/>
                                    <Border Grid.Row="2" Grid.Column="1" x:Name="AddressMask" Height="34" Margin="0,8,0,0" Background="#FF10161B" BorderBrush="#FF2A3844" BorderThickness="1" Visibility="Collapsed" ToolTip="Hidden by streamer mode. Turn streamer mode off to see or change it.">
                                        <TextBlock Text="•••••• hidden by streamer mode" Foreground="#FF8EA0AE" VerticalAlignment="Center" Margin="8,0"/>
                                    </Border>
                                    <TextBlock Grid.Row="2" Grid.Column="2" Margin="12,8,0,0" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#FF8EA0AE" Text="You can clear this or type another address. A home-network address only works on the same Wi-Fi. A public address works from outside after UDP 4200 is port forwarded. Or use Steam lobby."/>
                                    <TextBlock Grid.Row="3" Text="Server password" Foreground="#FF8EA0AE" VerticalAlignment="Center" Margin="0,8,0,0"/>
                                    <TextBox Grid.Row="3" Grid.Column="1" x:Name="PasswordBox" Height="34" Margin="0,8,0,0" Padding="8,0" VerticalContentAlignment="Center"/>
                                    <Border Grid.Row="3" Grid.Column="1" x:Name="PasswordMask" Height="34" Margin="0,8,0,0" Background="#FF10161B" BorderBrush="#FF2A3844" BorderThickness="1" Visibility="Collapsed" ToolTip="Hidden by streamer mode. Turn streamer mode off to see or change it.">
                                        <TextBlock Text="•••••• hidden by streamer mode" Foreground="#FF8EA0AE" VerticalAlignment="Center" Margin="8,0"/>
                                    </Border>
                                    <TextBlock Grid.Row="4" Text="UDP port" Foreground="#FF8EA0AE" VerticalAlignment="Center" Margin="0,8,0,0"/>
                                    <TextBox Grid.Row="4" Grid.Column="1" x:Name="ServerUdpBox" ToolTip="The UDP port friends use with a direct address. Forward this port on your router for joins from outside." Height="34" Margin="0,8,0,0" Padding="8,0" VerticalContentAlignment="Center" Text="4200" IsReadOnly="True"/>
                                    <TextBlock Grid.Row="4" Grid.Column="2" Margin="12,8,0,0" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#FF8EA0AE" Text="Direct-connection port. This is not the engine port."/>
                                    <TextBlock Grid.Row="5" Text="Steam advertise" Foreground="#FF8EA0AE" VerticalAlignment="Center" Margin="0,8,0,0"/>
                                    <CheckBox Grid.Row="5" Grid.Column="1" x:Name="SteamBox" ToolTip="Ticked, the server shows a Steam lobby under your Steam name. The next Start server uses it." Foreground="#FFD5DEE6" VerticalAlignment="Center" Margin="0,8,0,0" HorizontalAlignment="Left"/>
                                    <TextBlock Grid.Row="5" Grid.Column="2" Margin="12,8,0,0" VerticalAlignment="Center" TextWrapping="Wrap">
                                        <Run Text="Checked: the server shows a Steam lobby under your Steam name, and friends join from Steam lobby. " Foreground="#FFD5DEE6"/>
                                        <Run Text="Unchecked: that lobby stays off, and friends use the server address and UDP port. " Foreground="#FF8EA0AE"/>
                                        <Run Text="The next Start server uses this. A running server keeps what it started with until you restart it." Foreground="#FFD5DEE6"/>
                                    </TextBlock>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <!-- World presets (Coodsz Host only): a card fills the Coop settings below; Save settings keeps them. -->
                        <StackPanel x:Name="PresetCard" Visibility="Collapsed">
                            <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,12">
                                <StackPanel>
                                <TextBlock x:Name="PresetHeading" Text="World presets" HorizontalAlignment="Left" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                    <StackPanel>
                                        <TextBlock Text="A preset fills in the difficulty and life and death settings below. Nothing is written until you press Save settings." Foreground="#FF8EA0AE" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                        <UniformGrid x:Name="PresetButtons" Columns="3"/>
                                        <TextBlock x:Name="PresetNote" Foreground="#FF8EA0AE" TextWrapping="Wrap" Margin="0,10,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,12">
                            <StackPanel>
                            <TextBlock Text="Save and campaign" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <StackPanel>
                                    <UniformGrid Columns="2" Margin="0,0,0,8">
                                        <StackPanel Margin="0,0,8,0"><TextBlock Text="Campaign save" Foreground="#FF8EA0AE"/><ComboBox x:Name="SettingsSaveBox" ToolTip="The save these settings are kept for. Save settings also makes it the save that starts." Style="{StaticResource DifficultyBox}" Margin="0,4,0,0" RequestBringIntoView="KeepDropdownSelection"/></StackPanel>
                                        <StackPanel><TextBlock Text="Autosave interval (minutes)" Foreground="#FF8EA0AE"/><TextBox x:Name="AutosaveBox" ToolTip="How many minutes between autosaves of the campaign." Margin="0,4,0,0"/></StackPanel>
                                    </UniformGrid>
                                    <CheckBox x:Name="ClientTimeBox" ToolTip="Lets players pause and change the campaign speed. Players can only fast forward when this is ticked." Content="Allow clients to control campaign time" Foreground="#FFD5DEE6" Margin="0,4,0,0"/>
                                    <TextBlock x:Name="SaveProfileNote" Foreground="#FF8EA0AE" FontSize="13" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <!-- Coodsz Host moves Fast forwarding, Speed limit while players are in battle and
                             Allow clients to control campaign time in here (ShowGameSpeedGroup); the AD1259 build leaves it hidden. -->
                        <StackPanel x:Name="GameSpeedGroup" Visibility="Collapsed">
                            <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,12">
                                <StackPanel>
                                <TextBlock Text="Game speed" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                    <StackPanel x:Name="GameSpeedRows">
                                        <TextBlock Text="2x speed needs Fast forwarding set to On and Allow clients to control campaign time ticked. Press Save settings, then restart the server." FontWeight="SemiBold" Foreground="#FFE2C27A" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,12">
                            <StackPanel>
                            <TextBlock Text="Dedicated server" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <StackPanel>
                                    <WrapPanel>
                                        <CheckBox x:Name="LogFileBox" ToolTip="Makes the dedicated server write its own log file. Keep it on so problems can be found." Content="Write server log" Foreground="#FFD5DEE6" Margin="0,4,16,4"/>
                                        <CheckBox x:Name="AutoRestartBox" ToolTip="Saves and restarts the server on a timer while this tool is open. Players are warned 30 seconds before. Set the hours in Restart interval below." Content="Automatic restart" Foreground="#FFD5DEE6" Margin="0,4,16,4"/>
                                    </WrapPanel>
                                    <StackPanel Width="180" HorizontalAlignment="Left" Margin="0,8,0,0">
                                        <TextBlock Text="Restart interval (hours)" Foreground="#FF8EA0AE"/>
                                        <TextBox x:Name="RestartHoursBox" ToolTip="How many hours between automatic restarts, from 1 to 168, when Automatic restart is ticked." Margin="0,4,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,12">
                            <StackPanel>
                            <TextBlock Text="Campaign difficulty" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <StackPanel>
                                    <UniformGrid Columns="3" Margin="0,0,0,8">
                                        <StackPanel Margin="0,0,8,8"><TextBlock Text="Player received damage" Foreground="#FF8EA0AE"/><ComboBox Style="{StaticResource DifficultyBox}" x:Name="PlayerDamage" ToolTip="How much damage player characters take. Realistic is the hardest." Margin="0,4,0,0" RequestBringIntoView="KeepDropdownSelection"/></StackPanel>
                                        <StackPanel Margin="0,0,8,8"><TextBlock Text="Troop received damage" Foreground="#FF8EA0AE"/><ComboBox Style="{StaticResource DifficultyBox}" x:Name="TroopDamage" ToolTip="How much damage the troops in player parties take. Realistic is the hardest." Margin="0,4,0,0" RequestBringIntoView="KeepDropdownSelection"/></StackPanel>
                                        <StackPanel Margin="0,0,0,8"><TextBlock Text="Combat AI" Foreground="#FF8EA0AE"/><ComboBox Style="{StaticResource DifficultyBox}" x:Name="CombatAi" ToolTip="How well the AI fights in battles. Realistic is the hardest." Margin="0,4,0,0" RequestBringIntoView="KeepDropdownSelection"/></StackPanel>
                                        <StackPanel Margin="0,0,8,8"><TextBlock Text="Recruitment" Foreground="#FF8EA0AE"/><ComboBox Style="{StaticResource DifficultyBox}" x:Name="Recruitment" ToolTip="How hard it is to recruit troops. Realistic is the hardest." Margin="0,4,0,0" RequestBringIntoView="KeepDropdownSelection"/></StackPanel>
                                        <StackPanel Margin="0,0,8,8"><TextBlock Text="Map movement" Foreground="#FF8EA0AE"/><ComboBox Style="{StaticResource DifficultyBox}" x:Name="MapMovement" ToolTip="How fast player parties move on the campaign map. Realistic is the hardest." Margin="0,4,0,0" RequestBringIntoView="KeepDropdownSelection"/></StackPanel>
                                        <StackPanel Margin="0,0,0,8"><TextBlock Text="Stealth and disguise" Foreground="#FF8EA0AE"/><ComboBox Style="{StaticResource DifficultyBox}" x:Name="Stealth" ToolTip="How hard stealth and disguise are. Realistic is the hardest." Margin="0,4,0,0" RequestBringIntoView="KeepDropdownSelection"/></StackPanel>
                                        <StackPanel Margin="0,0,8,0"><TextBlock Text="Persuasion" Foreground="#FF8EA0AE"/><ComboBox Style="{StaticResource DifficultyBox}" x:Name="Persuasion" ToolTip="How likely persuasion in conversations is to work. Realistic is the hardest." Margin="0,4,0,0" RequestBringIntoView="KeepDropdownSelection"/></StackPanel>
                                        <StackPanel Margin="0,0,8,0"><TextBlock Text="Clan member death" Foreground="#FF8EA0AE"/><ComboBox Style="{StaticResource DifficultyBox}" x:Name="ClanDeath" ToolTip="How likely player clan members are to die. Realistic is the hardest." Margin="0,4,0,0" RequestBringIntoView="KeepDropdownSelection"/></StackPanel>
                                        <StackPanel><TextBlock Text="Battle death" Foreground="#FF8EA0AE"/><ComboBox Style="{StaticResource DifficultyBox}" x:Name="BattleDeath" ToolTip="How likely heroes are to die in battle. Realistic is the hardest." Margin="0,4,0,0" RequestBringIntoView="KeepDropdownSelection"/></StackPanel>
                                    </UniformGrid>
                                    <Grid Margin="0,6,0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="400"/><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Birth and death" VerticalAlignment="Center"/><ComboBox Grid.Column="1" x:Name="BirthDeathBox" ToolTip="Turns aging, births and natural deaths on or off. Not supported yet, so keep this Off." Style="{StaticResource DifficultyBox}" Width="160" HorizontalAlignment="Left" RequestBringIntoView="KeepDropdownSelection"/><TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap"><Run Text="On: aging, births, and natural deaths turn on. " Foreground="#FF8EA0AE"/><Run Text="Not supported yet, so keep this Off. " Foreground="#FF8EA0AE"/><Run Text="Off: they stay off. Battle deaths are a separate setting." Foreground="#FFD5DEE6"/></TextBlock></Grid>
                                    <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="400"/><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Auto allocate clan member perks" VerticalAlignment="Center"/><ComboBox Grid.Column="1" x:Name="AutoPerks" ToolTip="On picks perks for clan members by themselves. Off lets you choose them." Style="{StaticResource DifficultyBox}" Width="160" HorizontalAlignment="Left" RequestBringIntoView="KeepDropdownSelection"/><TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap"><Run Text="On: clan members get their perks chosen for them. " Foreground="#FF8EA0AE"/><Run Text="Off: you choose their perks." Foreground="#FFD5DEE6"/></TextBlock></Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,12">
                            <StackPanel>
                            <TextBlock Text="Network" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <StackPanel>
                                    <Grid Margin="0,8,0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="340"/><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Engine port (locked at 7210)" VerticalAlignment="Center"/><TextBox Grid.Column="1" x:Name="SettingsEnginePort" ToolTip="The port the dedicated server program uses inside your PC. It is locked and friends never type it." Width="160" HorizontalAlignment="Left" IsReadOnly="True"/><TextBlock Grid.Column="2" Text="Used by the dedicated server program. Friends do not type this." Foreground="#FF8EA0AE" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap"/></Grid>
                                    <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="340"/><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="UDP port (locked at 4200)" VerticalAlignment="Center"/><TextBox Grid.Column="1" x:Name="CoopPortBox" ToolTip="The UDP port friends use with a direct address. Forward this port on your router for joins from outside." Width="160" HorizontalAlignment="Left" IsReadOnly="True"/><TextBlock Grid.Column="2" Text="Direct-connection port. This is not the engine port." Foreground="#FF8EA0AE" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap"/></Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,12">
                            <StackPanel>
                            <TextBlock Text="General" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <StackPanel>
                                    <Grid Margin="0,3,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="400"/><ColumnDefinition Width="280"/><ColumnDefinition Width="56"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Battle size" VerticalAlignment="Center"/><Slider Grid.Column="1" x:Name="BattleSizeSlider" Minimum="200" Maximum="1000" Value="1000" TickFrequency="10" IsSnapToTickEnabled="True" ValueChanged="BattleSize_Changed" VerticalAlignment="Center"/><TextBlock Grid.Column="2" x:Name="BattleSizeLabel" VerticalAlignment="Center" Margin="8,0,0,0"/><TextBlock Grid.Column="3" VerticalAlignment="Center" Margin="8,0,0,0" TextWrapping="Wrap"><Run x:Name="BattleSizeRange" Text="Battle size for coop battles, from 200 to 1000. Coop's default is 1000. " Foreground="#FFD5DEE6"/><Run Text="The battle size in the game options does not change coop battles. The server uses this one for everyone. Troops above it join later as reinforcements. Takes effect after the server restarts." Foreground="#FF8EA0AE"/></TextBlock></Grid>
                                    <StackPanel x:Name="BigBattlePanel" Margin="400,0,0,8" Visibility="Collapsed"><TextBlock x:Name="BattleSizeTier" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="BattleSizeRam" Foreground="#FF8EA0AE" TextWrapping="Wrap" Margin="0,2,0,0"/><TextBlock x:Name="BattleSizeSuggested" Foreground="#FF8EA0AE" TextWrapping="Wrap" Margin="0,2,0,0"/><TextBlock Text="Changes apply from the next battle. Limitless Coop Compat reads the saved battle size while the server runs." Foreground="#FF8EA0AE" TextWrapping="Wrap" Margin="0,2,0,0"/></StackPanel>
                                    <WrapPanel x:Name="BattleSizeNotePanel" Margin="400,0,0,8" Visibility="Collapsed"><TextBlock x:Name="BattleSizeNote" Foreground="#FFE2C27A" TextWrapping="Wrap" MaxWidth="560" VerticalAlignment="Center" Margin="0,0,12,0"/><Button x:Name="AddLimitlessPatchButton" Style="{StaticResource Ghost}" Content="Add Limitless Coop Compat" Click="AddLimitlessPatch_Click" Visibility="Collapsed"/></WrapPanel>
                                    <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="400"/><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Fast forwarding" VerticalAlignment="Center"/><ComboBox Grid.Column="1" x:Name="FastForwardBox" ToolTip="On lets the host and players use fast forward. Off keeps everyone at normal speed." Style="{StaticResource DifficultyBox}" Width="160" HorizontalAlignment="Left" RequestBringIntoView="KeepDropdownSelection"/><TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap"><Run Text="On: the fast-forward button works for the host and for every player. " Foreground="#FF8EA0AE"/><Run Text="Off: the host and every player stay at normal speed. Players can only use it when Allow clients to control campaign time is ticked." Foreground="#FFD5DEE6"/></TextBlock></Grid>
                                    <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="400"/><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Auto pause" VerticalAlignment="Center"/><ComboBox Grid.Column="1" x:Name="AutoPauseBox" ToolTip="On pauses the campaign when every player is in a battle or a settlement." Style="{StaticResource DifficultyBox}" Width="160" HorizontalAlignment="Left" RequestBringIntoView="KeepDropdownSelection"/><TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap"><Run Text="On: pauses when every player is in a battle or a settlement. " Foreground="#FF8EA0AE"/><Run Text="Off: that pause is off. " Foreground="#FFD5DEE6"/><Run Text="Catch-up and an empty server still pause." Foreground="#FF8EA0AE"/></TextBlock></Grid>
                                    <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="400"/><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Client cheats" VerticalAlignment="Center"/><ComboBox Grid.Column="1" x:Name="ClientCheatsBox" ToolTip="On lets players add troops and gear and teleport. Off blocks those cheats." Style="{StaticResource DifficultyBox}" Width="160" HorizontalAlignment="Left" RequestBringIntoView="KeepDropdownSelection"/><TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap"><Run Text="On: clients can add troops, gear, and teleport. " Foreground="#FF8EA0AE"/><Run Text="Off: those cheats are blocked." Foreground="#FFD5DEE6"/></TextBlock></Grid>
                                    <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="400"/><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Speed limit while players are in battle" VerticalAlignment="Center"/><ComboBox Grid.Column="1" x:Name="SpeedLimitBox" ToolTip="On keeps campaign time at normal speed while any player is in a battle." Style="{StaticResource DifficultyBox}" Width="160" HorizontalAlignment="Left" RequestBringIntoView="KeepDropdownSelection"/><TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap"><Run Text="On: campaign time stays at 1x while any player is in a battle. " Foreground="#FF8EA0AE"/><Run Text="Off: time can speed up during battles." Foreground="#FFD5DEE6"/></TextBlock></Grid>
                                    <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="400"/><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Player nameplates" VerticalAlignment="Center"/><ComboBox Grid.Column="1" x:Name="NameplatesBox" ToolTip="On lets players show names above allied players." Style="{StaticResource DifficultyBox}" Width="160" HorizontalAlignment="Left" RequestBringIntoView="KeepDropdownSelection"/><TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap"><Run Text="On: clients can show names above allied players. " Foreground="#FF8EA0AE"/><Run Text="Off: nameplates are hidden." Foreground="#FFD5DEE6"/></TextBlock></Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,12">
                            <StackPanel>
                            <TextBlock Text="Economy" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <StackPanel>
                                    <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="400"/><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Settlement gold, food, and influence" VerticalAlignment="Center"/><ComboBox Grid.Column="1" x:Name="SettlementEconomyBox" ToolTip="On keeps gold, food and influence changing while players are in a settlement. Off freezes them there." Style="{StaticResource DifficultyBox}" Width="160" HorizontalAlignment="Left" RequestBringIntoView="KeepDropdownSelection"/><TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap"><Run Text="On: gold, food, influence, and income keep changing in towns. " Foreground="#FF8EA0AE"/><Run Text="Off: they stay frozen while you are in a settlement." Foreground="#FFD5DEE6"/></TextBlock></Grid>
                                    <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="400"/><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Battle gold, food, and influence" VerticalAlignment="Center"/><ComboBox Grid.Column="1" x:Name="BattleEconomyBox" ToolTip="Picks if gold, food and influence keep changing while players are in a battle, for at most one day, or not at all." Style="{StaticResource DifficultyBox}" Width="160" HorizontalAlignment="Left" RequestBringIntoView="KeepDropdownSelection"/><TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap"><Run Text="Off: nothing changes during a battle. " Foreground="#FFD5DEE6"/><Run Text="One day max: at most one day of change. " Foreground="#FF8EA0AE"/><Run Text="On: it keeps changing during battles." Foreground="#FF8EA0AE"/></TextBlock></Grid>
                                    <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="400"/><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Disconnected player gold, food, and influence" VerticalAlignment="Center"/><ComboBox Grid.Column="1" x:Name="DisconnectedEconomyBox" ToolTip="On keeps gold, food and influence changing for players who are offline. Off freezes theirs until they reconnect." Style="{StaticResource DifficultyBox}" Width="160" HorizontalAlignment="Left" RequestBringIntoView="KeepDropdownSelection"/><TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap"><Run Text="On: offline players still gain and lose gold, food, and influence. " Foreground="#FF8EA0AE"/><Run Text="Off: theirs stay frozen until they reconnect." Foreground="#FFD5DEE6"/></TextBlock></Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,12">
                            <StackPanel>
                            <TextBlock Text="Other" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <StackPanel>
                                    <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="340"/><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="AI battle join window (hours)" VerticalAlignment="Center"/><TextBox Grid.Column="1" x:Name="AiWindowBox" ToolTip="How many hours AI parties have to join a player battle after it starts. Press Save settings to keep it." Width="160" HorizontalAlignment="Left" VerticalAlignment="Center"/><TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap"><Run Text="AI parties can join a player battle only this many hours after it starts. " Foreground="#FF8EA0AE"/><Run Text="Higher lets more AI parties join, 0 keeps them out. " Foreground="#FFD5DEE6"/><Run Text="Coop's default is 6. From 0 to 168." Foreground="#FF8EA0AE"/></TextBlock></Grid>
