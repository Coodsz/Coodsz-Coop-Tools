                                            <Grid Margin="0,6,0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="320"/><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Workshop production multiplier" VerticalAlignment="Center" TextWrapping="Wrap"/><TextBox Grid.Column="1" x:Name="RbmWorkshopBox" Width="100" HorizontalAlignment="Left" ToolTip="A number from 0 to 10." AutomationProperties.AutomationId="RbmWorkshopBox"/><TextBlock Grid.Column="2" Text="How much workshops make. RBM's default is 1." Foreground="#FF8EA0AE" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap"/></Grid>
                                            <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="320"/><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Village production multiplier" VerticalAlignment="Center" TextWrapping="Wrap"/><TextBox Grid.Column="1" x:Name="RbmVillageBox" Width="100" HorizontalAlignment="Left" ToolTip="A number from 0 to 10." AutomationProperties.AutomationId="RbmVillageBox"/><TextBlock Grid.Column="2" Text="How much villages make. RBM's default is 0.5." Foreground="#FF8EA0AE" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap"/></Grid>
                                            <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="320"/><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Building cost multiplier" VerticalAlignment="Center" TextWrapping="Wrap"/><TextBox Grid.Column="1" x:Name="RbmBuildingBox" Width="100" HorizontalAlignment="Left" ToolTip="A whole number from 1 to 1000." AutomationProperties.AutomationId="RbmBuildingBox"/><TextBlock Grid.Column="2" Text="Town and castle building projects cost this many times more. 1 keeps the game's cost. RBM's default is 250." Foreground="#FF8EA0AE" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap"/></Grid>
                                            <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="320"/><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Starting gold multiplier" VerticalAlignment="Center" TextWrapping="Wrap"/><TextBox Grid.Column="1" x:Name="RbmGoldBox" Width="100" HorizontalAlignment="Left" ToolTip="A number from 0 to 100." AutomationProperties.AutomationId="RbmGoldBox"/><TextBlock Grid.Column="2" Text="Multiplies the starting gold of a new campaign. A campaign that already started does not change. RBM's default is 5." Foreground="#FF8EA0AE" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap"/></Grid>
                                        </StackPanel>
                                        <WrapPanel Margin="0,12,0,0">
                                            <Button x:Name="RbmSaveButton" Style="{StaticResource Primary}" Content="Save RBM settings" Click="RbmSave_Click" Margin="0,0,8,4" ToolTip="Writes these settings into RBM's config.xml on this PC. Your game uses them the next time it starts." AutomationProperties.AutomationId="RbmSaveButton"/>
                                            <Button x:Name="RbmCoopFriendlyButton" Style="{StaticResource Ghost}" Content="Coop friendly" Click="RbmCoopFriendly_Click" Margin="0,0,8,4" ToolTip="Turns off Lords buy equipment. The other settings stay as they are. Press Save RBM settings after." AutomationProperties.AutomationId="RbmCoopFriendlyButton"/>
                                            <Button x:Name="RbmReloadButton" Style="{StaticResource Ghost}" Content="Read the file again" Click="RbmReload_Click" Margin="0,0,8,4" ToolTip="Reads RBM's config.xml again and shows what it says now." AutomationProperties.AutomationId="RbmReloadButton"/>                                    </WrapPanel>
                                        <TextBlock x:Name="RbmNote" TextWrapping="Wrap" FontSize="14" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,12">
                            <StackPanel>
                            <TextBlock Text="MCM settings" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,8" FontSize="13">
                                <Run Text="This list is not your enabled mod list. " Foreground="#FFE2C27A" FontWeight="SemiBold"/>
                                <Run Text="Only mods that use MCM and have already written a settings file appear here. Most mods never write one. " Foreground="#FFD5DEE6"/>
                                <Run Text="If a mod is missing, click Load single-player MCM, or stop and start this setup once so the server can create its file. " Foreground="#FFD5DEE6"/>
                                <Run Text="You can change these while the server is running. " Foreground="#FFD5DEE6"/>
                                <Run Text="The running server does not pick them up. " Foreground="#FFD5DEE6" FontWeight="Bold"/>
                                <Run Text="Stop the server, then start this setup again." Foreground="#FFD5DEE6"/>
                            </TextBlock>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="280"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <DockPanel Margin="0,0,0,12">
                                        <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Content="Refresh MCM" Click="RefreshMcm_Click" ToolTip="Reads this setup's MCM settings files again."/>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Content="Clear unused MCM" Margin="0,0,8,0" Click="ClearUnusedMcm_Click" ToolTip="Deletes leftover optional MCM config folders under Documents ModSettings for mods that are off in this setup. Close Bannerlord and stop the server first."/>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Content="Load single-player MCM" Margin="0,0,8,0" Click="LoadSinglePlayerMcm_Click" ToolTip="Copies single-player MCM settings into this setup. The single-player files stay. A server that is already running keeps its current MCM until you stop it and press Start server."/>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource Primary}" Content="Enable all MCM" Margin="0,0,8,0" Click="EnableAllMcm_Click" ToolTip="Turns on every on and off option in the selected MCM mod and saves it. Restart this setup to use them."/>
                                        <StackPanel>
                                            <TextBlock Text="MCM mod" Foreground="#FF8EA0AE" Margin="0,0,0,4"/>
                                            <ComboBox x:Name="McmFileBox" ToolTip="Picks the MCM mod whose settings you want to see and change." Style="{StaticResource DifficultyBox}" SelectionChanged="McmFile_SelectionChanged"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <Grid Grid.Row="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <ListBox x:Name="McmValueList" Background="#FF10161B" Foreground="#FFD5DEE6" BorderBrush="#FF3A4C5C" FontFamily="Segoe UI" FontSize="13" DisplayMemberPath="Name" SelectionChanged="McmValue_SelectionChanged">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="Padding" Value="6,4"/>
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ListBoxItem">
                                                                <Border x:Name="Row" Background="Transparent" BorderBrush="Transparent" BorderThickness="2" Padding="{TemplateBinding Padding}">
                                                                    <ContentPresenter/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="Row" Property="BorderBrush" Value="#FFE2C27A"/>
                                                                    </Trigger>
                                                                    <Trigger Property="IsSelected" Value="True">
                                                                        <Setter TargetName="Row" Property="BorderBrush" Value="#FFE2C27A"/>
                                                                        <Setter TargetName="Row" Property="Background" Value="#FF1B2833"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                        </ListBox>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock x:Name="McmValueTitle" Text="Select an MCM option" FontWeight="SemiBold"/>
                                            <TextBlock Text="MCM value on the server" Foreground="#FF8EA0AE" Margin="0,12,0,4"/>
                                            <TextBox x:Name="McmValueBox" IsEnabled="False"/>
                                            <CheckBox x:Name="McmValueCheck" ToolTip="Turns the selected MCM option on or off. Press Apply MCM value to save it." Content="Enabled" Foreground="#FFD5DEE6" Margin="0,8,0,0" Visibility="Collapsed"/>
                                            <Grid x:Name="McmApplyHost" Margin="0,16,0,0" Background="Transparent">
                                                <Button x:Name="McmApply" ToolTip="Saves the value above for this setup. Stop the server and start this setup again to use it." Style="{StaticResource Primary}" Content="Apply MCM value" Margin="0" HorizontalAlignment="Stretch" IsEnabled="False" Click="ApplyMcm_Click"/>
                                                <Border IsHitTestVisible="False" BorderBrush="#FFE2C27A" BorderThickness="2" Background="Transparent">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Opacity" Value="0"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsMouseOver, ElementName=McmApplyHost}" Value="True">
                                                                    <Setter Property="Opacity" Value="1"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                </Border>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock x:Name="McmNote" Grid.Row="2" Foreground="#FF8EA0AE" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <!-- Advanced (collapsed): the mod settings players get. Settings sync needs no setup; this is for power users. -->
                        <StackPanel x:Name="ModSettingsArea">
                            <Button x:Name="ModSettingsToggle" Style="{StaticResource Ghost}" Content="Advanced: mod settings for players" HorizontalAlignment="Left" Margin="0,0,0,8" Click="ModSettingsToggle_Click" ToolTip="Players who join with a Coodsz launcher use your MCM settings for the session, so every PC runs the mods the same way. Their own files are never changed. Nothing to set up; open this only to change a value or let players keep their own settings for a mod."/>
                            <Border x:Name="ModSettingsPanel" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,12" Visibility="Collapsed">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="420"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel>
                                        <WrapPanel Margin="0,0,0,6">
                                            <Button x:Name="ModSettingsApply" Style="{StaticResource Primary}" Content="Apply" Margin="0,0,8,4" Click="ModSettingsApply_Click" ToolTip="Server running: sends your changes to the server, which uses them at once and passes them to players. Server stopped: saves them for the next launch."/>
                                            <Button Style="{StaticResource Ghost}" Content="Revert" Margin="0,0,8,4" Click="ModSettingsRevert_Click" ToolTip="Drops the changes you have not applied yet for this mod."/>
                                            <Button Style="{StaticResource Ghost}" Content="Reload" Margin="0,0,8,4" Click="ModSettingsReload_Click" ToolTip="Reads the settings the server last reported again."/>
                                            <Button Style="{StaticResource Ghost}" Content="Clear overrides" Margin="0,0,8,4" Click="ModSettingsClear_Click" ToolTip="Forgets the values you saved for this mod. They are no longer set at each launch."/>
                                        </WrapPanel>
                                        <TextBlock x:Name="ModSettingsStatus" Foreground="#FF8EA0AE" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Grid Grid.Row="1" Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="260"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <ListBox x:Name="ModSettingsList" Background="#FF10161B" Foreground="#FFD5DEE6" BorderBrush="#FF3A4C5C" FontFamily="Segoe UI" FontSize="13" HorizontalContentAlignment="Stretch" SelectionChanged="ModSettingsList_SelectionChanged">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="2,3">
                                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Subtitle}" Foreground="#FF8EA0AE" FontSize="11" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <DockPanel Grid.Column="2">
                                            <CheckBox x:Name="ModSettingsLock" DockPanel.Dock="Top" Content="Players use your settings for this mod" Foreground="#FFD5DEE6" Margin="0,0,0,8" Click="ModSettingsLock_Click" ToolTip="Ticked (the default): players get your settings for this mod while they play on your server. Unticked: each player keeps their own. Hotkeys, interface, sound and camera settings always stay each player's own."/>
                                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                <ItemsControl x:Name="ModSettingsGroups">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Margin="0,0,0,10">
                                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#FFE2C27A" Margin="0,4,0,4"/>
                                                                <ItemsControl ItemsSource="{Binding Properties}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Grid Margin="0,2" ToolTip="{Binding ToolTip}">
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="240"/>
                                                                                    <ColumnDefinition Width="180"/>
                                                                                    <ColumnDefinition Width="*"/>
                                                                                </Grid.ColumnDefinitions>
                                                                                <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="#FFD5DEE6"/>
                                                                                <Grid Grid.Column="1">
                                                                                    <CheckBox IsChecked="{Binding BoolValue, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding ToolTip}" Visibility="{Binding IsBool, Converter={StaticResource ModSettingsVisible}}" VerticalAlignment="Center"/>
                                                                                    <ComboBox ItemsSource="{Binding Choices}" ToolTip="{Binding ToolTip}" SelectedItem="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding IsChoice, Converter={StaticResource ModSettingsVisible}}"/>
                                                                                    <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding IsText, Converter={StaticResource ModSettingsVisible}}"/>
                                                                                </Grid>
                                                                                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center">
                                                                                    <TextBlock Text="{Binding RangeText}" Foreground="#FF8EA0AE" FontSize="11"/>
                                                                                    <TextBlock Text="{Binding Error}" Foreground="#FFE57373" FontSize="11" Margin="8,0,0,0" Visibility="{Binding HasError, Converter={StaticResource ModSettingsVisible}}"/>
                                                                                </StackPanel>
                                                                            </Grid>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </DockPanel>
                                    </Grid>
                                    <TextBlock x:Name="ModSettingsNote" Grid.Row="2" Foreground="#FF8EA0AE" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                        <!-- Advanced (collapsed): which server program this tool starts. -->
                        <Button x:Name="ServerFolderToggle" Style="{StaticResource Ghost}" Content="Advanced: server folder" HorizontalAlignment="Left" Margin="0,0,0,8" Click="ServerFolderToggle_Click" ToolTip="Set server folder, Download Coop server, Open server folder, and where the server program is."/>
                        <Border x:Name="ServerFolderPanel" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,12" Visibility="Collapsed">
                            <StackPanel>
                                <WrapPanel>
                                    <Button Style="{StaticResource Ghost}" Content="Open server folder" Click="OpenFolder_Click" ToolTip="Opens the dedicated server folder in Explorer." Margin="0"/>
                                    <Button Style="{StaticResource Ghost}" Content="Set server folder" Click="SetServerFolder_Click" ToolTip="Chooses which BannerlordCoopServer.exe this tool starts. Use it when the dedicated server was not found, or this tool found the wrong copy."/>
                                    <Button Style="{StaticResource Ghost}" Content="Download Coop server" Click="DownloadCoopServer_Click" ToolTip="Opens the Coop dedicated server download (about 4.5 GB) in your browser. It is linked at the bottom of Coop's release notes, not under Assets."/>
                                </WrapPanel>
                                <TextBlock Margin="0,8,0,0" Foreground="#FFD5DEE6" FontSize="13" TextWrapping="Wrap" Text="Set server folder chooses which BannerlordCoopServer.exe this tool starts. Use it when the dedicated server was not found, or this tool found the wrong copy. The file is in Workshop folder 3770450698\DedicatedServer, or in the short folder you unzipped the Coop v0.1.7 dedicated server download to, like C:\CoopServer. Download Coop server opens that download (about 4.5 GB), linked at the bottom of Coop's release notes, not under Assets."/>
                            </StackPanel>
                        </Border>
                        <!-- Advanced (collapsed): the Windows fixes. Unblock DLLs turns red when the log says Windows blocked a DLL, and this group opens then (ShowBlockedDllFix). -->
                        <Button x:Name="WindowsToggle" Style="{StaticResource Ghost}" Content="Advanced: Windows" HorizontalAlignment="Left" Margin="0,0,0,8" Click="WindowsToggle_Click" ToolTip="Unblock DLLs, Fix antivirus and Allow through firewall."/>
                        <Border x:Name="WindowsPanel" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,12" Visibility="Collapsed">
                            <StackPanel>
                                <WrapPanel>
                                    <Button x:Name="UnblockButton" Style="{StaticResource Ghost}" Content="Unblock DLLs" Click="Unblock_Click" ToolTip="Clears the Windows download block on files in the server folder. This button turns red when the server log says Windows blocked a DLL."/>
                                    <Button Style="{StaticResource Ghost}" Content="Fix antivirus" Click="FixAntivirus_Click" AutomationProperties.AutomationId="FixAntivirus" ToolTip="Shows the folders your antivirus should skip on this PC and opens Windows Security. It changes no setting itself."/>
                                    <Button Style="{StaticResource Ghost}" Content="Allow through firewall" Click="Firewall_Click" ToolTip="Adds an inbound Windows Firewall rule for the server's UDP port and program. Windows asks for permission first. The same button is on the Dashboard."/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    </ScrollViewer>
                </Grid>
                <Grid x:Name="LogsPage" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <!-- The server log in the dark frame of the Dashboard's log card; the page title is in the header. -->
                    <Border CornerRadius="8" BorderThickness="1" Padding="14,10" Background="#FF0A1015" BorderBrush="#FF2A3844">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Each server line is shortened and spaced out." FontSize="12" FontWeight="SemiBold" Foreground="#FF8EA0AE" Margin="0,0,0,8"/>
                            <RichTextBox x:Name="ServerLog" IsReadOnly="True" IsDocumentEnabled="False"
                                         BorderBrush="#FF3A4C5C" BorderThickness="1" Padding="12" FontSize="15"
                                         Background="#FF0C0A08" Foreground="#FFD5DEE6" FontFamily="Segoe UI"
                                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                         SizeChanged="ServerLog_SizeChanged">
                                <FlowDocument PagePadding="0" FontFamily="Segoe UI" FontSize="15" Foreground="#FFD5DEE6"/>
                            </RichTextBox>
                        </DockPanel>
                    </Border>
                    <!-- My reports shows beside Send my logs once a report was sent (ReportRepliesUi.AddMyReports). -->
                    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,12,0,0">
                        <StackPanel>
                            <WrapPanel>
                                <Button Style="{StaticResource AddMods}" Content="Open server logs" MinHeight="48" MinWidth="180" Padding="18,12" FontSize="16" HorizontalAlignment="Left" Margin="0,0,12,8" Click="Logs_Click" ToolTip="Opens the logs folder and selects the newest coop-server log plus a dated host-action copy for Discord."/>
                                <Button Style="{StaticResource AddMods}" Content="Send my logs" MinHeight="48" MinWidth="180" Padding="18,12" FontSize="16" Margin="0,0,0,8" HorizontalAlignment="Left" Click="SendLogs_Click" ToolTip="Sends the cleaned server logs, what this window captured, the action log, the server settings without the password and a check of the server's Coop files to Coodsz. You see every file first, then you get a short code to post in Discord. Save a copy instead is in that window."/>
                                <ContentControl x:Name="LogsMyReportsSlot" Focusable="False" VerticalAlignment="Center" Margin="0,0,12,8"/>
                                <Button Style="{StaticResource Ghost}" Content="Run Rescue save" MinHeight="48" Padding="18,12" FontSize="16" Margin="0,0,0,8" Click="RescueSave_Click" ToolTip="Starts the server once with every save fix, also the ones Start server leaves out. Use it when support asks for it. Press Stop server first. It starts the server for you, so don't press Start server."/>
                                <Button Style="{StaticResource Ghost}" Content="?" MinHeight="48" MinWidth="36" Margin="6,0,0,8" Click="RescueHelp_Click" ToolTip="How Rescue save works"/>
                            </WrapPanel>
                            <TextBlock Margin="0,4,0,0" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="16" FontWeight="SemiBold" Foreground="#FFE2C27A" Text="Opens the server logs. Use this when you need more than the lines above. Send my logs sends them to Coodsz and gives you a short code to post in Discord."/>
                        </StackPanel>
                    </Border>
                </Grid>
                <keep:CheatsPage x:Name="KeepCheats" Visibility="Collapsed"/>
                <keep:PlayersPage x:Name="KeepPlayers" Visibility="Collapsed"/>
                <keep:MapPage x:Name="KeepMap" Visibility="Collapsed"/>
                <keep:EncyclopediaPage x:Name="KeepEncyclopedia" Visibility="Collapsed"/>
                <keep:GuidesPage x:Name="KeepGuides" Visibility="Collapsed"/>
                <Grid x:Name="ConsolePage" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="3*" MinHeight="274"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="4*"/>
                    </Grid.RowDefinitions>
                    <!-- The page title (Console) is in the header; the state line and the link sit in a card over the backdrop. -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="14,10">
                    <StackPanel>
                        <TextBlock x:Name="ConsoleState" FontSize="18" Margin="0" Foreground="#FF8EA0AE" Text="This list only keeps what you send and the reply. The server log stays on Logs."/>
                        <Border Background="#F010161C" BorderBrush="#FFE2C27A" BorderThickness="1" CornerRadius="2" Padding="12,8" HorizontalAlignment="Left" Margin="0,8,0,0">
                            <TextBlock FontSize="20" TextWrapping="Wrap">
                                <Run Text="Command names and what they do: " Foreground="#FFD5DEE6"/>
                                <Hyperlink Click="OpenCheatList_Click" Foreground="#FFE2C27A" TextDecorations="Underline" FontWeight="Bold" FontSize="22">bannerlordcoop.com/cheats</Hyperlink>
                            </TextBlock>
                        </Border>
                    </StackPanel>
                    </Border>

                    <!-- Live server output, the command box and the recent commands, in a card so the tick boxes read over the backdrop.
                         The page has no scroll bar, so the row's MinHeight (274) is what is docked in it: the card's border and padding
                         (22), two rows of chips at most (6 + 60, more scroll), the command box row (8 + 30), the Clear row (8 + 30) and
                         the output box's own MinHeight (110). The output always shows several lines; on a short window (WindowFit clamps
                         MinHeight to the screen) the command browser below, which has no MinHeight, gives way instead. -->
                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="10">
                    <DockPanel>
                        <ScrollViewer DockPanel.Dock="Bottom" MaxHeight="60" Margin="0,6,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                            <WrapPanel x:Name="RecentCommands" Tag="coodsz:no-translate"/>
                        </ScrollViewer>
                        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                            <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Content="Send" Click="Send_Click" ToolTip="Sends the command in the box to the running server."/>
                            <TextBox x:Name="CommandBox" ToolTip="Type a server command here and press Enter or Send." KeyDown="CommandBox_KeyDown"/>
                        </DockPanel>
                        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0" LastChildFill="False">
                            <Button Style="{StaticResource Ghost}" Content="Clear" Click="Clear_Click" ToolTip="Empties the command list below. The server is not touched." Margin="0"/>
                            <CheckBox x:Name="AutoScroll" ToolTip="Keeps the list scrolled to the newest line." Content="Auto-scroll" IsChecked="True" Foreground="#FFD5DEE6" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            <CheckBox x:Name="ConsoleServerLines" ToolTip="Shows the live server output in the list too, not only what you send." Content="Show server output" IsChecked="True" Foreground="#FFD5DEE6" VerticalAlignment="Center" Margin="12,0,0,0"/>
                            <Button Style="{StaticResource Ghost}" Content="Copy" Click="Copy_Click" ToolTip="Copies the whole command list to the clipboard."/>
                        </DockPanel>
                        <RichTextBox x:Name="HistoryBox" IsReadOnly="True" IsUndoEnabled="False" MinHeight="110"
                                 VerticalScrollBarVisibility="Auto" Background="#FF10161B" FontFamily="Consolas" FontSize="13"
                                 Foreground="#FF9BC49A" BorderBrush="#FF3A4C5C">
                            <FlowDocument Background="#FF10161B" PagePadding="0" FontFamily="Consolas" FontSize="13"/>
                        </RichTextBox>
                    </DockPanel>
                    </Border>

                    <GridSplitter Grid.Row="2" Height="8" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="Transparent" Cursor="SizeNS" ResizeBehavior="PreviousAndNext"/>

                    <!-- Every Coop command from bannerlordcoop.com/cheats: categories on the left, the list, and the picked command's form (Shared/CoopCommandBrowser.xaml) -->
                    <ui:CoopCommandBrowser x:Name="CommandBrowser" Grid.Row="3"/>
                </Grid>
            </Grid>
        </DockPanel>
        </Grid>
    </Grid>
</Window>
