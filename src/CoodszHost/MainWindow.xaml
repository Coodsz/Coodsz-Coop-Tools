<Window x:Class="CoodszHost.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CoodszHost"
        xmlns:keep="clr-namespace:CoodszHost.Keep"
        xmlns:ui="clr-namespace:Coodsz.Ui"
        Title="Coodsz Coop Server Tool" Height="900" Width="1280"
        MinHeight="720" MinWidth="900"
        Background="#FF0E1418" Foreground="#FFD5DEE6" FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="ModSettingsVisible"/>
        <!-- Crash reports (CrashReportUi in CrashReportWindow.cs): the red of the log alert, the gold of the buttons and a calm green. -->
        <SolidColorBrush x:Key="ReportRed" Color="#FFE2786C"/>
        <SolidColorBrush x:Key="ReportRedBack" Color="#FF3A201C"/>
        <SolidColorBrush x:Key="ReportGold" Color="#FFE2C27A"/>
        <SolidColorBrush x:Key="ReportGoldBack" Color="#FF3A3420"/>
        <SolidColorBrush x:Key="ReportGreen" Color="#FF8FCB9B"/>
        <SolidColorBrush x:Key="ReportGreenBack" Color="#FF1E3326"/>
        <SolidColorBrush x:Key="ReportInk" Color="#FF0E1418"/>
        <ControlTemplate x:Key="HoverButton" TargetType="Button">
            <Border x:Name="Edge" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
            </Border>
            <ControlTemplate.Triggers>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsMouseOver" Value="True"/>
                        <Condition Property="IsEnabled" Value="True"/>
                    </MultiTrigger.Conditions>
                    <Setter TargetName="Edge" Property="BorderBrush" Value="#FFE2C27A"/>
                    <Setter TargetName="Edge" Property="BorderThickness" Value="2"/>
                </MultiTrigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Palatino Linotype"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="#FFD5DEE6"/>
        </Style>
        <Style x:Key="Primary" TargetType="Button">
            <Setter Property="Background" Value="#FF1F4E79"/>
            <Setter Property="Foreground" Value="#FFD5DEE6"/>
            <Setter Property="BorderBrush" Value="#FF8EB4D4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="22,9"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template" Value="{StaticResource HoverButton}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF2A6294"/>
                    <Setter Property="BorderBrush" Value="#FF8EB4D4"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="UpdateInstall" TargetType="Button" BasedOn="{StaticResource Primary}">
            <Setter Property="Background" Value="#FF6A4A30"/>
            <Setter Property="Foreground" Value="#FFFFE7B8"/>
            <Setter Property="BorderBrush" Value="#FFE2C27A"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="AddMods" TargetType="Button" BasedOn="{StaticResource Primary}">
            <Setter Property="Background" Value="#FF3A3420"/>
            <Setter Property="Foreground" Value="#FFE2C27A"/>
            <Setter Property="BorderBrush" Value="#FFE2C27A"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <TextBlock x:Name="Label" Text="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFE2C27A"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FFE2C27A"/>
                                <Setter TargetName="Label" Property="Foreground" Value="#FF1A160C"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Label" Property="Foreground" Value="#FF7A6E62"/>
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.55"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Ghost" TargetType="Button">
            <Setter Property="Background" Value="#FF1B2833"/>
            <Setter Property="Foreground" Value="#FFD5DEE6"/>
            <Setter Property="BorderBrush" Value="#FF3A4C5C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template" Value="{StaticResource HoverButton}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF243646"/>
                    <Setter Property="BorderBrush" Value="#FF8EB4D4"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Danger" TargetType="Button">
            <Setter Property="Background" Value="#FF4A2A28"/>
            <Setter Property="Foreground" Value="#FFF3E0DC"/>
            <Setter Property="BorderBrush" Value="#FF6E3C38"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template" Value="{StaticResource HoverButton}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF5C3432"/>
                    <Setter Property="BorderBrush" Value="#FF8A4C48"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FFD5DEE6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Edge" BorderBrush="Transparent" BorderThickness="2" Padding="4,2" Background="Transparent">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="16" Height="16" BorderBrush="#FF3A4C5C" BorderThickness="1" Background="#FF10161B" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <Path x:Name="Mark" Data="M 2 8 L 6 12 L 14 3" Stroke="#FF8EB4D4" StrokeThickness="1.6" Visibility="Collapsed" Margin="0,1,0,0"/>
                                </Border>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Edge" Property="BorderBrush" Value="#FFE2C27A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FF10161B"/>
            <Setter Property="Foreground" Value="#FFD5DEE6"/>
            <Setter Property="BorderBrush" Value="#FF2A3844"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="CaretBrush" Value="#FFD5DEE6"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#FFE2C27A"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#FFE2C27A"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Padding" Value="14"/>
            <Setter Property="BorderBrush" Value="#FF3A4C5C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="2"/>
            <!-- Near solid (94%), so text on a card keeps its contrast over the picture behind the pages. -->
            <Setter Property="Background" Value="#F0151D24"/>
        </Style>
        <local:InverseBooleanConverter x:Key="InverseBool"/>
        <Style x:Key="DifficultyItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#FFD5DEE6"/>
            <Setter Property="Background" Value="#FF10161B"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" Background="#FF10161B" Padding="{TemplateBinding Padding}">
                            <ContentPresenter TextElement.Foreground="#FFD5DEE6"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#FF1B2833"/>
                                <Setter Property="TextElement.Foreground" Value="#FFD5DEE6"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#FF1F4E79"/>
                                <Setter Property="TextElement.Foreground" Value="#FFD5DEE6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- The Coop setting boxes show "True" as On and "VeryEasy" as Very easy, translated; other boxes show their items as they are. -->
        <local:SettingChoiceLabel x:Key="ChoiceLabel"/>
        <Style x:Key="DifficultyBox" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#FFD5DEE6"/>
            <Setter Property="Background" Value="#FF10161B"/>
            <Setter Property="BorderBrush" Value="#FF3A4C5C"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource DifficultyItem}"/>
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock TextWrapping="Wrap" Foreground="#FFD5DEE6" FontSize="14" FontFamily="Segoe UI">
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource ChoiceLabel}">
                                    <Binding/>
                                    <Binding Path="(local:SettingChoiceLabel.ChoiceLabels)" RelativeSource="{RelativeSource AncestorType=ComboBox}"/>
                                    <Binding Path="(local:SettingChoiceLabel.Language)"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="BoxEdge" Background="#FF10161B" BorderBrush="#FF2A3844" BorderThickness="1" MinHeight="32">
                                            <DockPanel LastChildFill="True">
                                                <Path DockPanel.Dock="Right" Data="M 0 0 L 4 4 L 8 0" Stroke="#FF8EB4D4" StrokeThickness="1.2" Margin="0,0,10,0" VerticalAlignment="Center" Width="8" Height="4"/>
                                                <TextBlock Margin="10,6,8,6" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#FFD5DEE6" FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=ComboBox}}" FontFamily="Segoe UI">
                                                    <TextBlock.Text>
                                                        <MultiBinding Converter="{StaticResource ChoiceLabel}">
                                                            <Binding Path="SelectedItem" RelativeSource="{RelativeSource AncestorType=ComboBox}"/>
                                                            <Binding Path="(local:SettingChoiceLabel.ChoiceLabels)" RelativeSource="{RelativeSource AncestorType=ComboBox}"/>
                                                            <Binding Path="(local:SettingChoiceLabel.Language)"/>
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </DockPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="BoxEdge" Property="BorderBrush" Value="#FFE2C27A"/>
                                            </Trigger>
                                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                <Setter TargetName="BoxEdge" Property="BorderBrush" Value="#FF8EB4D4"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="None" IsOpen="{TemplateBinding IsDropDownOpen}">
                                <Border Background="#FF10161B" BorderBrush="#FF3A4C5C" BorderThickness="1" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer MaxHeight="220" CanContentScroll="False">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <!-- No picture behind the pages: the plain Keep background (Window Background) keeps the cards readable (redesign wave 1). -->
        <Grid>
        <Grid.ColumnDefinitions>
            <!-- 220 wide, or 64 with icons only under 1000 px (NavRail.Fit in MainWindow.xaml.cs). -->
            <ColumnDefinition x:Name="NavColumn" Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Style="{StaticResource Keep.Sidebar}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="12,18,12,12">
                    <DockPanel Margin="4,0,0,0">
                        <!-- The brand mark: the banner of the tool icon in the tool's own colour (ToolAccent.Apply in App.xaml.cs). -->
                        <Viewbox x:Name="BrandMark" DockPanel.Dock="Left" Width="30" Height="30" VerticalAlignment="Top" Margin="0,0,10,0">
                            <Canvas Width="128" Height="128">
                                <Path Data="{StaticResource Keep.IconBanner}" Fill="{DynamicResource Keep.ToolAccent}" Stroke="#FFEF9F27" StrokeThickness="6"/>
                            </Canvas>
                        </Viewbox>
                        <!-- COODSZ big in the serif font, the tool name small and in capitals under it (Edition.Brand). -->
                        <StackPanel x:Name="BrandText" VerticalAlignment="Center">
                            <TextBlock x:Name="BrandWord" Text="COODSZ" FontFamily="Palatino Linotype" FontSize="22" FontWeight="Normal" Foreground="#FFD5DEE6" Tag="coodsz:no-translate"/>
                            <TextBlock x:Name="ToolHeading" Text="COOP SERVER TOOL" FontSize="10.5" FontWeight="SemiBold" Foreground="#FF8EA0AE" Margin="1,1,0,0" TextTrimming="CharacterEllipsis" Tag="coodsz:no-translate"/>
                        </StackPanel>
                    </DockPanel>
                    <TextBlock x:Name="EditionCredit" Visibility="Collapsed" Margin="0,6,0,0" FontSize="12" Foreground="#FFE2C27A" TextWrapping="Wrap" Text="AD1259 coop fixes by SkyApolo. Thank you for the help!"/>
                    <!-- Send my logs (CrashReportUi): on every page, for a crash, a stuck join, a desync or lag. -->
                    <ContentControl x:Name="SendLogsSlot" Margin="0,14,0,0" HorizontalAlignment="Left"/>
                    <!-- Send my logs as an icon in the 64 px sidebar (ShowCompactSidebar). -->
                    <Button x:Name="SendLogsCompact" AutomationProperties.Name="Send my logs" Style="{StaticResource Keep.Nav}" ui:NavRail.Icon="{StaticResource Keep.IconSend}" Visibility="Collapsed" Margin="0,10,0,0" Click="SendLogs_Click" ToolTip="Stuck joining, a desync, lag or something else? Sends your cleaned logs to Coodsz and gives you a short code to post in Discord. You see every file before anything is sent."/>
                </StackPanel>
                <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Keep.Line}" BorderThickness="0,1,0,0" Margin="12,0,12,12" Padding="0,10,0,0">
                    <Grid>
                        <!-- The 64 px sidebar shows a More button instead (CompactMore_Click opens Language, What's new, Donate and the rest). -->
                        <Button x:Name="CompactMore" AutomationProperties.Name="More" Style="{StaticResource Keep.Nav}" ui:NavRail.Icon="{StaticResource Keep.IconMore}" Visibility="Collapsed" Click="CompactMore_Click" ToolTip="Language, What's new, Donate, Join my server and streamer mode."/>
                        <Viewbox x:Name="FooterFit" StretchDirection="DownOnly" HorizontalAlignment="Left">
                            <StackPanel>
                                <!-- Streamer mode (Coodsz Host only): hides IPs, invite codes, Steam ids and the join password on screen. -->
                                <Button x:Name="StreamerButton" Style="{StaticResource Keep.Button}" Visibility="Collapsed" Margin="0,0,0,10" HorizontalContentAlignment="Left" Click="StreamerMode_Click"
                                        ToolTip="Hides IP addresses, invite and reward codes, Steam ids and the join password on screen, so you can stream this window. Copy buttons still copy the real value.">
                                    <StackPanel Orientation="Horizontal">
                                        <Path x:Name="StreamerIcon" Data="M 1 8 C 3 4 5.5 2.5 8 2.5 C 10.5 2.5 13 4 15 8 C 13 12 10.5 13.5 8 13.5 C 5.5 13.5 3 12 1 8 Z M 8 5.5 A 2.5 2.5 0 1 0 8.01 5.5" Stroke="{StaticResource Keep.TextDim}" StrokeThickness="1.3" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="StreamerText" Text="Streamer mode off" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <ContentControl x:Name="LanguageSlot" Margin="0,12,0,0" HorizontalAlignment="Left"/>
                                <ContentControl x:Name="WhatsNewSlot" Margin="0,8,0,0" HorizontalAlignment="Left"/>
                                <ContentControl x:Name="DonateSlot" Margin="0,8,0,0" HorizontalAlignment="Left"/>
                                <!-- The Realm promo as a small link; Coodsz chose a Dashboard card plus this link (build-plan.md 7). -->
                                <Button x:Name="RealmLink" Style="{StaticResource Keep.BtnLink}" Content="Join my server" Tag="Realm" Click="Nav_Click" Margin="0,8,0,0" ToolTip="The Realm Bannerlord, my custom modded server"/>
                                <TextBlock x:Name="VersionText" Foreground="#FF8EA0AE" FontSize="11" HorizontalAlignment="Left" Margin="6,8,0,0"/>
                            </StackPanel>
                        </Viewbox>
                    </Grid>
                </Border>
                <!-- The page buttons sit at the top in a list that scrolls on a short window. -->
                <ScrollViewer x:Name="NavScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,4">
                    <ScrollViewer.Resources>
                        <!-- The thin Keep scroll bar, so a short window does not show a wide light one beside the page buttons. -->
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource Keep.ScrollBar}"/>
                    </ScrollViewer.Resources>
                    <StackPanel x:Name="NavList" VerticalAlignment="Top" Margin="12,0">
                        <Button x:Name="NavDashboard" ToolTip="Shows the Dashboard with Start server, the server state, the invite and who is connected." Style="{StaticResource Keep.Nav}" ui:NavRail.Icon="{StaticResource Keep.IconDashboard}" Content="Dashboard" Click="Nav_Click" Tag="Dashboard"/>
                        <!-- Saves keeps the Tag Server, so every ShowPage("Server") still opens it. -->
                        <Button x:Name="NavServer" ToolTip="Shows the Saves page with the saved setups, the campaign save, backups and the map." Style="{StaticResource Keep.Nav}" ui:NavRail.Icon="{StaticResource Keep.IconSaves}" Content="Saves" Click="Nav_Click" Tag="Server"/>
                        <Button x:Name="NavModules" ToolTip="Shows the Mods page, where you turn mods on and off and set their load order." Style="{StaticResource Keep.Nav}" ui:NavRail.Icon="{StaticResource Keep.IconMods}" Content="Mods" Click="Nav_Click" Tag="Modules"/>
                        <Button x:Name="NavSettings" ToolTip="Shows the Settings page with the Coop gameplay, difficulty, RBM and MCM settings." Style="{StaticResource Keep.Nav}" ui:NavRail.Icon="{StaticResource Keep.IconSettings}" Content="Settings" Click="Nav_Click" Tag="Settings"/>
                        <Button x:Name="NavPlayers" ToolTip="Shows who is on the server now and the ban list." Style="{StaticResource Keep.Nav}" ui:NavRail.Icon="{StaticResource Keep.IconPlayers}" Content="Players" Click="Nav_Click" Tag="Players" Visibility="Collapsed"/>
                        <Button x:Name="NavCheats" ToolTip="Shows the cheats you can send to the running server, like setting a player's gold." Style="{StaticResource Keep.Nav}" ui:NavRail.Icon="{StaticResource Keep.IconCheats}" Content="Cheats" Click="Nav_Click" Tag="Cheats"/>
                        <Button x:Name="NavConsole" ToolTip="Lets you type commands to the running server and see the replies." Style="{StaticResource Keep.Nav}" ui:NavRail.Icon="{StaticResource Keep.IconConsole}" Content="Console" Click="Nav_Click" Tag="Console"/>
                        <Button x:Name="NavLogs" ToolTip="Shows the server log lines this window captured." Style="{StaticResource Keep.Nav}" ui:NavRail.Icon="{StaticResource Keep.IconLogs}" Content="Logs" Click="Nav_Click" Tag="Logs"/>
                        <Button x:Name="NavMap" ToolTip="Shows the campaign map of the running server with towns, players and lords." Style="{StaticResource Keep.Nav}" ui:NavRail.Icon="{StaticResource Keep.IconMap}" Content="Map" Click="Nav_Click" Tag="Map" Visibility="Collapsed"/>
                        <Button x:Name="NavEncyclopedia" ToolTip="Browses the kingdoms, clans, lords, towns, troops and items of the running campaign." Style="{StaticResource Keep.Nav}" ui:NavRail.Icon="{StaticResource Keep.IconEncyclopedia}" Content="Encyclopedia" Click="Nav_Click" Tag="Encyclopedia" Visibility="Collapsed"/>
                        <Button x:Name="NavGuides" ToolTip="Short guides for hosting with this tool." Style="{StaticResource Keep.Nav}" ui:NavRail.Icon="{StaticResource Keep.IconGuides}" Content="Guides" Click="Nav_Click" Tag="Guides" Visibility="Collapsed"/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
        <DockPanel Grid.Column="1">
            <!-- The header: page title, the setup picker, the state pill and the clock. -->
            <Border DockPanel.Dock="Top" Style="{StaticResource Keep.HeaderBar}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="PageTitle" Grid.Column="0" Style="{StaticResource Keep.PageTitle}" Text="Dashboard"/>
                    <StackPanel Grid.Column="1" Margin="16,0,8,0" Width="280" VerticalAlignment="Center">
                        <!-- The Locked tag sits on the label line, so it does not take width from the setup name (the name wrapped to many lines at the smallest window size). -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="Saved setup" Foreground="#FF8EA0AE" FontSize="11" VerticalAlignment="Center"/>
                            <Border x:Name="LockedSetupTag" Visibility="Collapsed" VerticalAlignment="Center" Margin="8,0,0,0" Padding="6,0" Background="#FF1B2833" BorderBrush="#FF3A4C5C" BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#x1F512;" FontFamily="Segoe UI Emoji" FontSize="10" Foreground="#FFD2A36A" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBlock Text="Locked" FontSize="11" FontWeight="SemiBold" Foreground="#FFD2A36A" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <ComboBox x:Name="ProfileBox" ToolTip="Picks a saved setup and loads its save, map, mods and MCM. A running server stays up until you start again." Style="{StaticResource DifficultyBox}" MinHeight="48" FontSize="17" RequestBringIntoView="KeepDropdownSelection" SelectionChanged="ProfileBox_SelectionChanged"/>
                        <TextBlock x:Name="LockedSetupText" Visibility="Collapsed" FontSize="12" FontWeight="SemiBold" Foreground="#FFD2A36A" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        <!-- While the server runs: picking a setup is for the next Start, the mods stay blocked (ApplyModListBlock). -->
                        <TextBlock x:Name="SetupRunningNote" Visibility="Collapsed" Text="Changes what the next Start uses." FontSize="11" Foreground="#FF8EA0AE" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                        <ui:StatusPill x:Name="StatePill" Kind="Stopped" Text="Stopped" ToolTip="What the server is doing now."/>
                        <!-- The older state line: StateText and StatusDot stay for the code that sets them, StateDetail shows the uptime. -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                            <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="#FFE0A23A" Margin="0,0,8,0" Visibility="Collapsed"/>
                            <StackPanel>
                                <TextBlock x:Name="StateText" Text="STOPPED" FontWeight="Bold" Visibility="Collapsed"/>
                                <TextBlock x:Name="StateDetail" Text="Server is stopped." Foreground="#FF8EA0AE" FontSize="11"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                    <ui:HeaderClock Grid.Column="3" Margin="16,0,0,0"/>
                </Grid>
            </Border>
            <!-- The notices: one at a time, the most urgent first (BannerStack.Priority), the rest behind "N more notices". -->
            <ui:BannerStack x:Name="Banners" DockPanel.Dock="Top" MaxShown="1">
                <!-- Coodsz's notice from compat-list/announcement.json (AnnouncementUi.cs in Shared/Frame): after the crash, report and reply bars, before the other notices, until Dismiss. -->
                <ui:Banner x:Name="AnnouncementBanner" Kind="Warn" CanDismiss="True" Visibility="Collapsed" Margin="18,12,18,0" ui:BannerStack.Priority="3"/>
                <Border x:Name="UpdateNoticeBar" DockPanel.Dock="Top" Visibility="Collapsed" Background="#C8151D24" BorderBrush="#FF3A4C5C" BorderThickness="0,0,0,1" Padding="16,10" ui:BannerStack.Priority="4">
                    <DockPanel LastChildFill="True">
                        <Button x:Name="InstallUpdateButton" ToolTip="Downloads and installs the new version. This window closes when it is done." DockPanel.Dock="Right" Content="Install update" Click="InstallUpdate_Click" MinWidth="160" Margin="16,0,0,0" Style="{StaticResource UpdateInstall}" VerticalAlignment="Center"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="UpdateNotice" FontSize="16" FontWeight="SemiBold" Foreground="#FFD2A36A" TextWrapping="Wrap"/>
                            <ProgressBar x:Name="UpdateProgress" Height="12" Margin="0,8,0,0" Minimum="0" Maximum="1" Visibility="Collapsed" Foreground="#FFE2C27A" Background="#FF3A3420" BorderBrush="#FFE2C27A" BorderThickness="1"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border x:Name="LogAlert" DockPanel.Dock="Top" Visibility="Collapsed" Background="#FF3A201C" BorderBrush="#FFE2786C" BorderThickness="0,0,0,1" Padding="16,12" ui:BannerStack.Priority="0">
                    <DockPanel LastChildFill="True">
                        <Button x:Name="LogAlertConfirm" ToolTip="Hides this warning. Read the end of the Logs page first." DockPanel.Dock="Right" Style="{StaticResource Ghost}" Content="Confirm" Click="LogAlertConfirm_Click" MinWidth="132" MinHeight="48" Margin="16,0,0,0" Padding="18,12" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Background="#FF3A3420" Foreground="#FFE2C27A" BorderBrush="#FFE2C27A" BorderThickness="2"/>
                        <TextBlock x:Name="LogAlertText" FontFamily="Segoe UI" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="#FFE2786C" Cursor="Hand" MouseLeftButtonUp="LogAlert_Click" Text="The server ran into a problem. Open the Logs tab, scroll all the way down, and read What happened, What to do, and What not to do. If you need more information, use the server logs."/>
                    </DockPanel>
                </Border>
                <Border x:Name="RescueNotice" DockPanel.Dock="Top" Visibility="Collapsed" Background="#FF17241C" BorderBrush="#FF8FCB9B" BorderThickness="0,0,0,2" Padding="16,12" ui:BannerStack.Priority="3">
                    <DockPanel LastChildFill="True">
                        <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Content="Dismiss" Click="RescueNoticeDismiss_Click" MinWidth="120" Margin="16,0,0,0" VerticalAlignment="Center" ToolTip="Hides this note. The Logs page and the action log keep it."/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="RescueNoticeTitle" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="#FF8FCB9B"/>
                            <TextBlock x:Name="RescueNoticeBody" FontSize="14" TextWrapping="Wrap" Foreground="#FFD5DEE6" Margin="0,6,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <!-- Coodsz answered your report CR-XXXXX (ReplyBannerBar in ReportReplyWindow.cs): shows until every answer is read, no x. -->
                <ContentControl x:Name="ReplyBannerHost" DockPanel.Dock="Top" Visibility="Collapsed" Margin="18,12,18,0" ui:BannerStack.Priority="2"/>
                <!-- The crash report bar (ServerCrashBar in CrashReportWindow.cs): the one time card, and Send server crash report after the server crashed. -->
                <ContentControl x:Name="CrashBarHost" DockPanel.Dock="Top" Visibility="Collapsed" Margin="18,12,18,0" ui:BannerStack.Priority="1"/>
            </ui:BannerStack>
            <Grid Margin="18">
                <!-- The tool's picture behind the whole page area (Keep.BackdropArt, set by Backdrop.Apply in App.xaml.cs) under a dark
                     gradient (Keep.BackdropOverlayTop to Keep.BackdropOverlayBottom). The brush always fills the area and keeps the
                     right side in view, where the castle is. A tool with no picture shows the plain background. -->
                <Rectangle x:Name="PageBackdrop" Margin="-18" RenderOptions.BitmapScalingMode="HighQuality" IsHitTestVisible="False">
                    <Rectangle.Fill>
                        <ImageBrush ImageSource="{DynamicResource Keep.BackdropArt}" Stretch="UniformToFill" AlignmentX="Right" AlignmentY="Center"/>
                    </Rectangle.Fill>
                </Rectangle>
                <Rectangle x:Name="PageBackdropShade" Margin="-18" IsHitTestVisible="False">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="{DynamicResource Keep.BackdropOverlayTop}" Offset="0"/>
                            <GradientStop Color="{DynamicResource Keep.BackdropOverlayBottom}" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <!-- The Dashboard (both editions): the server state with the one big button, the addresses, the newest server
                     lines and the game time on the left; the players, the mods and the Realm card on the right. -->
                <ScrollViewer x:Name="DashboardPage" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" RequestBringIntoView="KeepDropdownSelection">
                    <!-- The side column goes under the main one when the page is too narrow for both (FitDashboard). -->
                    <Grid x:Name="DashGrid">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition x:Name="DashSideColumn" Width="300"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel x:Name="DashMain" Margin="0,0,12,0">
                            <!-- First run (no server folder or no save yet): numbered steps with a button each (ShowFirstRunSteps). -->
                            <Border x:Name="FirstRunCard" Style="{StaticResource Card}" Margin="0,0,0,12" Padding="14" Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock Text="Get your server ready" Style="{StaticResource SectionTitle}" FontSize="20" Margin="0,0,0,10"/>
                                    <ui:StepsStrip x:Name="FirstRunSteps"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Padding="14">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,10">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:Chip x:Name="PasswordChip" Kind="Mute" Text="Password Open" Margin="0,0,6,0" ToolTip="Open: anyone with the address can join. Set: friends type the password. Change it on Settings, under Join."/>
                                            <ui:Chip x:Name="SteamChip" Kind="Mute" Text="Steam lobby Off" ToolTip="Whether the server shows a Steam lobby under your Steam name. Change it on Settings, under Join."/>
                                        </StackPanel>
                                        <TextBlock Text="Server status" Style="{StaticResource SectionTitle}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <UniformGrid Columns="4" Margin="0,0,0,12">
                                        <Border Style="{StaticResource Card}" Margin="0,0,8,0"><StackPanel><TextBlock Text="CURRENT SAVE" Foreground="#FF8EA0AE" FontSize="11"/><TextBlock x:Name="OverviewSave" FontSize="16" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/></StackPanel></Border>
                                        <Border Style="{StaticResource Card}" Margin="0,0,8,0"><StackPanel><TextBlock Text="PROFILE" Foreground="#FF8EA0AE" FontSize="11"/><TextBlock x:Name="OverviewProfile" FontSize="16" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/></StackPanel></Border>
                                        <Border Style="{StaticResource Card}" Margin="0,0,8,0"><StackPanel><TextBlock Text="ENABLED MODS" Foreground="#FF8EA0AE" FontSize="11"/><TextBlock x:Name="OverviewMods" FontSize="16" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/></StackPanel></Border>
                                        <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="PORTS" Foreground="#FF8EA0AE" FontSize="11"/><TextBlock x:Name="OverviewPorts" FontSize="16" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/></StackPanel></Border>
                                    </UniformGrid>
                                    <!-- The values the Home page had: uptime, the last save and backup of this world, and the autosave. -->
                                    <UniformGrid Columns="4" Margin="0,0,0,12">
                                        <Border Style="{StaticResource Card}" Margin="0,0,8,0"><StackPanel><TextBlock Text="UPTIME" Foreground="#FF8EA0AE" FontSize="11"/><TextBlock x:Name="DashUptime" Text="-" FontSize="16" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" Tag="coodsz:no-translate"/></StackPanel></Border>
                                        <Border Style="{StaticResource Card}" Margin="0,0,8,0"><StackPanel><TextBlock Text="LAST SAVE" Foreground="#FF8EA0AE" FontSize="11"/><TextBlock x:Name="DashLastSave" Text="-" FontSize="16" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/></StackPanel></Border>
                                        <Border Style="{StaticResource Card}" Margin="0,0,8,0"><StackPanel><TextBlock Text="LAST BACKUP" Foreground="#FF8EA0AE" FontSize="11"/><TextBlock x:Name="DashLastBackup" Text="-" FontSize="16" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/></StackPanel></Border>
                                        <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="AUTOSAVE" Foreground="#FF8EA0AE" FontSize="11"/><TextBlock x:Name="DashAutosave" Text="Off" FontSize="16" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/></StackPanel></Border>
                                    </UniformGrid>
                                    <TextBlock x:Name="ServerLoadText" Foreground="#FF8EA0AE" FontSize="12" Margin="2,-4,0,12" Visibility="Collapsed" AutomationProperties.AutomationId="ServerLoad" ToolTip="CPU and memory of the server engine, every few seconds."/>
                                    <!-- The preset tags of the world that starts (Coodsz Host only, WorldPresets.Chips). -->
                                    <ItemsControl x:Name="DashChips" Margin="0,0,0,8" Visibility="Collapsed" Tag="coodsz:no-translate">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#FF1B2833" BorderBrush="#FF3A4C5C" BorderThickness="1" CornerRadius="9" Padding="8,2" Margin="0,0,6,6">
                                                    <TextBlock Text="{Binding}" FontSize="12" Foreground="#FFD5DEE6"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <!-- Two wrapping rows, so a narrow window moves buttons down instead of hiding them. -->
                                    <WrapPanel Margin="0,4,0,8">
                                        <!-- The one big button (ux-plan 1.3): Start server and Stop server share the spot; ShowServerActions shows one and sets its words. -->
                                        <Grid Margin="0,0,12,4" VerticalAlignment="Center">
                                            <Button x:Name="StartButton" ToolTip="Starts the dedicated server with this setup's save, map, mods and settings." Style="{StaticResource Keep.BtnState}" Content="Start server" Click="Start_Click"/>
                                            <Button x:Name="StopButton" ToolTip="Asks first, then saves the campaign and stops the server. Players are disconnected." Style="{StaticResource Keep.BtnStateStop}" Content="Stop server" Click="Stop_Click" Visibility="Collapsed"/>
                                        </Grid>
                                        <WrapPanel VerticalAlignment="Center">
                                            <Button x:Name="StopStartingButton" Style="{StaticResource Danger}" Content="Stop" Click="Stop_Click" Visibility="Collapsed" Margin="0,2,6,2" ToolTip="Stops the server while it is still starting. Asks first."/>
                                            <Button x:Name="SaveWorldButton" Visibility="Collapsed" Style="{StaticResource Ghost}" Content="Save game" Click="Save_Click" ToolTip="Tells the running server to save the campaign now."/>
                                            <Button x:Name="RestartButton" Visibility="Collapsed" ToolTip="Asks first, then saves the campaign, disconnects players and loads the same save again." Style="{StaticResource Ghost}" Content="Restart" Click="Restart_Click"/>
                                            <Button x:Name="LastGoodButton" Visibility="Collapsed" Style="{StaticResource Ghost}" Content="Last good save" Click="RestartLastGood_Click" ToolTip="Stops the server without saving. Puts back the newest save from before the hero lost their party, then starts the server."/>
                                            <Button x:Name="BackupNowButton" Style="{StaticResource Ghost}" Content="Backup now" Click="BackupNow_Click" Visibility="Collapsed" ToolTip="Zips a copy of this world's save into Save Backups. Load backup on the Saves page puts one back."/>
                                            <Button x:Name="StopAutoRestartButton" Style="{StaticResource Ghost}" Content="Stop auto restart" Click="StopAutoRestart_Click" Visibility="Collapsed" ToolTip="Cancels the restart that waits after the crash. The server stays stopped until you press Start server."/>
                                        </WrapPanel>
                                    </WrapPanel>
                                    <!-- This PC's Bannerlord is newer than 1.4.8 (NewerGame): the same line as the Made for card, next to Start server. -->
                                    <TextBlock x:Name="NewerGameText" Visibility="Collapsed" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Keep.WarningInk}" TextWrapping="Wrap" Margin="0,2,0,4"/>
                                    <!-- Something went wrong? Send your logs (CrashReportUi), next to Start server. -->
                                    <ContentControl x:Name="SendLogsLinkSlot" HorizontalAlignment="Left" Margin="0,0,0,8"/>
                                    <CheckBox x:Name="CrashRestartBox" Content="Restart the server if it crashes" Foreground="#FFD5DEE6" Margin="0,0,0,8" HorizontalAlignment="Left" Checked="CrashRestart_Changed" Unchecked="CrashRestart_Changed" ToolTip="Starts the server again after a crash. It waits 10 seconds, longer after each crash, and gives up after more than 3 crashes in 10 minutes. A broken save, a changed Coop module or terms that were not accepted are never restarted."/>
                                    <Border Margin="0,12,0,0" Padding="10,8" CornerRadius="4" Background="#F0151D24" BorderBrush="#FF3A4C5C" BorderThickness="1">
                                        <TextBlock x:Name="ControlStatus" Text="Ready." Foreground="#FF8EA0AE" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    </Border>
                                    <!-- The save mods card with its one click fix, under the server buttons in both editions. -->
                                    <ui:SaveModsCard x:Name="ServerSaveMods" Margin="0,12,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="14">
                                <StackPanel>
                                    <WrapPanel Orientation="Horizontal">
                                        <TextBlock Text="Addresses your friends can use" Style="{StaticResource SectionTitle}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Style="{StaticResource Primary}" Content="Copy invite" Click="CopyInvite_Click" ToolTip="Copies a short message for Discord with the best addresses and the port. The password is never in it."/>
                                            <Button Style="{StaticResource Ghost}" Content="How will friends join?" Click="HowJoin_Click" ToolTip="Checks your network, then shows step by step how your friends can join."/>
                                            <Button Style="{StaticResource Ghost}" Content="?" Click="JoinGuide_Click" ToolTip="How to join" MinWidth="36"/>
                                        </StackPanel>
                                    </WrapPanel>
                                    <TextBlock x:Name="JoinBestText" Margin="0,6,0,8" Foreground="#FF8FCB9B" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <ItemsControl x:Name="JoinAddressList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="150"/>
                                                        <ColumnDefinition Width="200"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    <TextBox Grid.Column="1" Text="{Binding Value, Mode=OneWay}" IsReadOnly="True" Height="30" Padding="6,0" VerticalContentAlignment="Center" FontFamily="Consolas"/>
                                                    <Button Grid.Column="2" Style="{StaticResource Ghost}" Content="Copy" Click="CopyAddress_Click" ToolTip="Copies this address. Streamer mode still copies the real one." Margin="6,0,0,0" Padding="10,4"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding Note}" Foreground="#FF8EA0AE" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <CheckBox x:Name="RouterPortBox" Content="Open the port on my router automatically" Foreground="#FFD5DEE6" Margin="0,8,0,0" Checked="RouterPort_Changed" Unchecked="RouterPort_Changed" ToolTip="Uses UPnP on your router while the server runs, like Porthole. The port is closed again when the server stops or this tool closes."/>
                                    <TextBlock x:Name="RouterPortStatus" Margin="24,4,0,0" Foreground="#FF8EA0AE" FontSize="12" TextWrapping="Wrap"/>
                                    <WrapPanel Margin="0,8,0,0">
                                        <Button x:Name="FirewallButton" Style="{StaticResource Ghost}" Content="Allow through firewall" Click="Firewall_Click" Margin="0" ToolTip="Adds an inbound Windows Firewall rule for the server's UDP port and program. Windows asks for permission first."/>
                                        <Button Style="{StaticResource Ghost}" Content="Check again" Click="CheckJoining_Click" ToolTip="Reads your network addresses and firewall again and updates the list above."/>
                                    </WrapPanel>
                                    <TextBlock x:Name="FirewallStatus" Margin="0,4,0,0" Foreground="#FF8EA0AE" FontSize="12" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                            <ui:LogCard x:Name="DashLog" Margin="0,12,0,0" MaxLines="8"/>
                            <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="14">
                                <StackPanel>
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Style="{StaticResource Ghost}" Content="Pause game" Click="PauseGame_Click" ToolTip="Pauses campaign time on the running server."/>
                                            <Button Style="{StaticResource Ghost}" Content="Resume game" Click="ResumeGame_Click" ToolTip="Lets campaign time run again on the running server until you press Pause game, also when every player is in a settlement or a battle."/>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Game time" Style="{StaticResource SectionTitle}" FontSize="20" FontWeight="SemiBold"/>
                                        <TextBlock Text="Pause or resume campaign time on the server. Fast forward is on Settings." Foreground="#FF8EA0AE" Margin="0,4,12,8" TextWrapping="Wrap"/>
                                        <TextBlock x:Name="GameTimeStatus" Text="Server is not running." FontWeight="SemiBold"/>
                                    </StackPanel>
                                </DockPanel>
                                <!-- Coodsz Host only; the AD1259 build keeps this card as it was (see ShowGameSpeedArea). -->
                                <Border x:Name="GameSpeedArea" Visibility="Collapsed" Margin="0,12,0,0" Padding="0,12,0,0" Background="Transparent" BorderBrush="#FF3A4C5C" BorderThickness="0,1,0,0" AutomationProperties.AutomationId="GameSpeedArea">
                                    <StackPanel>
                                        <TextBlock Text="Game speed" Style="{StaticResource SectionTitle}" FontSize="20" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="GameSpeedLine" FontSize="15" FontWeight="SemiBold" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                        <TextBlock x:Name="GameSpeedBattleLine" FontSize="14" Foreground="#FFD5DEE6" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                        <WrapPanel Margin="0,10,0,0">
                                            <Button x:Name="GameSpeedButton" ToolTip="Turns 2x campaign speed on or off and saves it right away. A running server only uses it after a restart." Style="{StaticResource Primary}" Content="Turn on 2x speed" Click="GameSpeed_Click" Margin="0,0,8,4" AutomationProperties.AutomationId="GameSpeedButton"/>
                                            <Button x:Name="GameSpeedBattleButton" ToolTip="Turns the speed limit while players are in a battle on or off and saves it right away. A running server only uses it after a restart." Style="{StaticResource Ghost}" Content="Turn off battle speed limit" Click="GameSpeedBattle_Click" Margin="0,0,8,4" AutomationProperties.AutomationId="GameSpeedBattleButton"/>
                                            <Button x:Name="GameSpeedRestartButton" Style="{StaticResource Ghost}" Content="Restart server" Click="Restart_Click" Margin="0,0,8,4" Visibility="Collapsed" ToolTip="Restarts the server so the new speed applies. It asks first, saves the campaign and disconnects players." AutomationProperties.AutomationId="GameSpeedRestart"/>
                                        </WrapPanel>
                                        <TextBlock x:Name="GameSpeedRestartLine" FontSize="14" FontWeight="SemiBold" Foreground="#FFE2C27A" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                        <TextBlock Text="Players change the speed on the campaign map with the time buttons at the bottom of the screen, or with the keys 1, 2 and 3." FontSize="13" Foreground="#FF8EA0AE" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                                </StackPanel>
                            </Border>
                            <Border x:Name="PlayersCard" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="14">
                                <StackPanel>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Content="Refresh players" Click="RefreshPlayers_Click" ToolTip="Reads who is connected to the server again."/>
                                        <TextBlock x:Name="OnlinePlayersText" Text="Online players: 0" Style="{StaticResource SectionTitle}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <ComboBox x:Name="PlayerBox" ToolTip="Picks a connected player for Open profile or Ban player." Style="{StaticResource DifficultyBox}" Width="280" RequestBringIntoView="KeepDropdownSelection" DropDownOpened="PlayerBox_DropDownOpened"/>
                                        <Button x:Name="OpenProfileButton" Style="{StaticResource Primary}" Content="Open profile" Click="OpenProfile_Click" ToolTip="Skills, equipment, inventory and army of the selected player"/>
                                        <Button Style="{StaticResource Danger}" Content="Ban player" Click="BanPlayer_Click" ToolTip="Adds the selected player's SteamID64 to the ban list below."/>
                                    </StackPanel>
                                    <TextBlock Text="Banned players" FontWeight="SemiBold" FontSize="13" Margin="0,14,0,6"/>
                                    <ListBox x:Name="BanList" Height="120" Background="#FF10161B" Foreground="#FFD5DEE6" BorderBrush="#FF3A4C5C" FontFamily="Segoe UI" FontSize="13">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Foreground" Value="#FFD5DEE6"/>
                                                <Setter Property="Background" Value="#FF10161B"/>
                                                <Setter Property="FontFamily" Value="Segoe UI"/>
                                                <Setter Property="FontSize" Value="13"/>
                                                <Setter Property="Padding" Value="6,4"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <Border x:Name="Row" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="2" Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Row" Property="BorderBrush" Value="#FFE2C27A"/>
                                                                </Trigger>
                                                                <Trigger Property="IsSelected" Value="True">
                                                                    <Setter TargetName="Row" Property="BorderBrush" Value="#FFE2C27A"/>
                                                                    <Setter TargetName="Row" Property="Background" Value="#FF1B2833"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter Property="Background" Value="#FF1B2833"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                    </ListBox>
                                    <DockPanel Margin="0,8,0,0">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <Button Style="{StaticResource Ghost}" Content="Add SteamID" Click="AddBanIds_Click" ToolTip="Bans players who are not online, by SteamID64. One per line."/>
                                            <Button Style="{StaticResource Ghost}" Content="Refresh bans" Click="RefreshBans_Click" ToolTip="Reads the ban list file again."/>
                                            <Button Style="{StaticResource Ghost}" Content="Unban player" Click="UnbanPlayer_Click" ToolTip="Takes the player selected in the ban list off it."/>
                                        </StackPanel>
                                        <TextBlock x:Name="BanStatus" Text="No banned players" Foreground="#FF8EA0AE" VerticalAlignment="Center"/>
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <StackPanel x:Name="DashSide" Grid.Column="1">
                            <!-- Coodsz Host: who is online, from the same list as the Players page (the AD1259 build shows PlayersCard on the left). -->
                            <Border x:Name="OnlinePlayersCard" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,12" Visibility="Collapsed">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,8">
                                        <Button DockPanel.Dock="Right" Style="{StaticResource Keep.BtnLink}" Content="All players" Tag="Players" Click="Nav_Click" ToolTip="Opens the Players page with the ban list and the profiles."/>
