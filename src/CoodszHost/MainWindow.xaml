                                        <Grid Margin="0,8,0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="340"/><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Seconds to answer" VerticalAlignment="Center"/><TextBox Grid.Column="1" x:Name="PvpSecondsBox" ToolTip="How long players have to pick an answer. Press Save settings to keep it." Width="160" HorizontalAlignment="Left" VerticalAlignment="Center"/><TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap"><Run Text="How long a player has to act before the meeting ends or the battle starts. Every new choice starts the count again. " Foreground="#FF8EA0AE"/><Run Text="30 by default. From 10 to 300." Foreground="#FF8EA0AE"/></TextBlock></Grid>
