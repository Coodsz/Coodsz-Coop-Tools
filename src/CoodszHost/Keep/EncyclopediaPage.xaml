<UserControl x:Class="CoodszHost.Keep.EncyclopediaPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{StaticResource Keep.TextMain}" FontFamily="Segoe UI">
    <!--
        Encyclopedia: the running world, read from the server (coodsz.world). Sections on the left,
        a list with search and filter chips in the middle, the entry's card on the right. Links in the
        card open other entries; Back goes to the one before. Read only.
    -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Visible"/>
        <Style TargetType="ScrollBar" BasedOn="{StaticResource Keep.ScrollBar}"/>
        <Style x:Key="EntryItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource Keep.TextMain}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="2" Padding="10,6" Margin="0,0,0,1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Keep.BgRaised}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Keep.AccentSoft}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Fact" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Keep.BgRaised}"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="MinWidth" Value="110"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Style="{StaticResource Keep.Panel}" HorizontalAlignment="Stretch" Margin="0,0,0,14">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="The running world, read from the server. Nothing here changes the game." Style="{StaticResource Keep.Dim}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                <TextBlock x:Name="ReadText" Style="{StaticResource Keep.Dim}" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <Button x:Name="RefreshButton" Style="{StaticResource Keep.Button}" Click="Refresh_Click" ToolTip="Read the world from the server again. Lords move and towns change hands while you play.">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource Keep.IconRefresh}" Stroke="{StaticResource Keep.TextDim}" StrokeThickness="1.5" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Read again" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
        </Border>

        <!-- Stopped, starting, reading or could not read: one card instead of the lists. -->
        <Border x:Name="StateCard" Grid.Row="1" Style="{StaticResource Keep.Card}" VerticalAlignment="Top" HorizontalAlignment="Left" MaxWidth="640" Padding="26,22">
            <StackPanel>
                <Path Data="{StaticResource Keep.IconInfo}" Stroke="{StaticResource Keep.Accent}" StrokeThickness="1.4" Width="22" Height="22" HorizontalAlignment="Left" Margin="0,0,0,12"/>
                <TextBlock x:Name="StateHeadline" Text="Start the server to browse the world" Style="{StaticResource Keep.H2}" FontSize="20" TextWrapping="Wrap"/>
                <TextBlock x:Name="StateLine" Style="{StaticResource Keep.Dim}" TextWrapping="Wrap" Margin="0,6,0,0"
                           Text="The Encyclopedia reads the kingdoms, clans, lords, towns, troops and items of the running campaign. Start the server and it fills in by itself."/>
                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                    <Button x:Name="StartButton" Style="{StaticResource Keep.Gold}" Padding="18,9" Click="Start_Click" ToolTip="Starts the server. The Encyclopedia fills in by itself once it is running.">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M 0 0 L 10 6 L 0 12 Z" Fill="{StaticResource Keep.OnAccent}" Width="10" Height="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Start server" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="TryAgainButton" Style="{StaticResource Keep.Button}" Content="Try again" Padding="16,9" Click="Refresh_Click" ToolTip="Reads the world from the server again." Visibility="Collapsed"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid x:Name="Browser" Grid.Row="1" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sections -->
            <StackPanel x:Name="SectionList">
                <RadioButton Style="{StaticResource Keep.Side}" GroupName="EncSection" Tag="Lords" IsChecked="True" Checked="Section_Checked" ToolTip="Shows the heroes and lords of the campaign." Margin="0,0,0,2">
                    <Grid><TextBlock Text="Heroes and lords"/><TextBlock x:Name="CountLords" Tag="coodsz:no-translate" Foreground="{StaticResource Keep.TextFaint}" FontSize="11.5" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
                </RadioButton>
                <RadioButton Style="{StaticResource Keep.Side}" GroupName="EncSection" Tag="Clans" Checked="Section_Checked" ToolTip="Shows the clans of the campaign." Margin="0,0,0,2">
                    <Grid><TextBlock Text="Clans"/><TextBlock x:Name="CountClans" Tag="coodsz:no-translate" Foreground="{StaticResource Keep.TextFaint}" FontSize="11.5" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
                </RadioButton>
                <RadioButton Style="{StaticResource Keep.Side}" GroupName="EncSection" Tag="Kingdoms" Checked="Section_Checked" ToolTip="Shows the kingdoms of the campaign." Margin="0,0,0,2">
                    <Grid><TextBlock Text="Kingdoms"/><TextBlock x:Name="CountKingdoms" Tag="coodsz:no-translate" Foreground="{StaticResource Keep.TextFaint}" FontSize="11.5" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
                </RadioButton>
                <RadioButton Style="{StaticResource Keep.Side}" GroupName="EncSection" Tag="Settlements" Checked="Section_Checked" ToolTip="Shows the towns, castles and villages." Margin="0,0,0,2">
                    <Grid><TextBlock Text="Settlements"/><TextBlock x:Name="CountSettlements" Tag="coodsz:no-translate" Foreground="{StaticResource Keep.TextFaint}" FontSize="11.5" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
                </RadioButton>
                <RadioButton Style="{StaticResource Keep.Side}" GroupName="EncSection" Tag="Troops" Checked="Section_Checked" ToolTip="Shows every troop kind in the game." Margin="0,0,0,2">
                    <Grid><TextBlock Text="Troops"/><TextBlock x:Name="CountTroops" Tag="coodsz:no-translate" Foreground="{StaticResource Keep.TextFaint}" FontSize="11.5" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
                </RadioButton>
                <RadioButton Style="{StaticResource Keep.Side}" GroupName="EncSection" Tag="Items" Checked="Section_Checked" ToolTip="Shows every item in the game." Margin="0,0,0,2">
                    <Grid><TextBlock Text="Items"/><TextBlock x:Name="CountItems" Tag="coodsz:no-translate" Foreground="{StaticResource Keep.TextFaint}" FontSize="11.5" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
                </RadioButton>
                <Border Height="1" Background="{StaticResource Keep.BorderDim}" Margin="4,10"/>
                <TextBlock Text="Pictures come from Build pictures on the Cheats page. Lords, clans and towns show a letter for now." Style="{StaticResource Keep.Dim}" FontSize="11.5" TextWrapping="Wrap" Margin="6,0"/>
            </StackPanel>

            <!-- List -->
            <Border Grid.Column="2" Style="{StaticResource Keep.Card}" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBox x:Name="SearchBox" Style="{StaticResource Keep.Text}" TextChanged="Search_Changed"/>
                    <ScrollViewer Grid.Row="1" MaxHeight="96" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                        <WrapPanel x:Name="Chips" Tag="coodsz:no-translate"/>
                    </ScrollViewer>
                    <TextBlock Grid.Row="2" x:Name="CountText" Tag="coodsz:no-translate" Style="{StaticResource Keep.Dim}" FontSize="11.5" Margin="2,6"/>
                    <ListBox Grid.Row="3" x:Name="EntryList" Tag="coodsz:no-translate" Background="Transparent" BorderThickness="0"
                             ItemContainerStyle="{StaticResource EntryItem}" SelectionChanged="Entry_Selected"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource Keep.TextDim}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding Tag}" Foreground="{StaticResource Keep.Accent}" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Entry -->
            <Border Grid.Column="4" Style="{StaticResource Keep.Card}" Padding="0" ClipToBounds="True">
                <Grid>
                    <TextBlock x:Name="PickText" Text="Pick an entry from the list." Style="{StaticResource Keep.Dim}" Margin="22,18"/>
                    <ScrollViewer x:Name="CardScroll" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                        <StackPanel x:Name="Card" Margin="22,18" Tag="coodsz:no-translate">
                            <Button x:Name="BackButton" Style="{StaticResource Keep.Icon}" HorizontalAlignment="Left" Padding="6,3" Margin="0,0,0,10" Click="Back_Click" ToolTip="Goes back to the entry you looked at before.">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M 8 1 L 2 6 L 8 11" Stroke="{StaticResource Keep.TextMain}" StrokeThickness="1.6" Width="10" Height="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding BackText}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="120" Height="120" CornerRadius="2" ClipToBounds="True" Background="{StaticResource Keep.Picture}" Margin="0,0,16,0" VerticalAlignment="Top">
                                    <Grid>
                                        <TextBlock Text="{Binding Initial}" FontFamily="Palatino Linotype" FontSize="44" Foreground="{StaticResource Keep.Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Visibility="{Binding Image.NoImage, Converter={StaticResource Visible}}"/>
                                        <Image Source="{Binding Image.Source}" Stretch="Uniform" Visibility="{Binding Image.HasImage, Converter={StaticResource Visible}}"/>
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Top">
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource Keep.H1}" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Keep.Dim}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    <Border Background="{StaticResource Keep.AccentSoft}" CornerRadius="2" Padding="9,2" Margin="0,8,0,0" HorizontalAlignment="Left"
                                            Visibility="{Binding HasTag, Converter={StaticResource Visible}}">
                                        <TextBlock Text="{Binding TagText}" FontSize="11.5" Foreground="{StaticResource Keep.AccentHover}"/>
                                    </Border>
                                    <WrapPanel Margin="0,10,0,0">
                                        <Button Style="{StaticResource Keep.SmallGold}" Content="{Binding ProfileText}" Click="Profile_Click" ToolTip="Opens the profile window of this player." Visibility="{Binding IsPlayer, Converter={StaticResource Visible}}" Margin="0,0,6,6"/>
                                        <Button Style="{StaticResource Keep.Small}" Content="{Binding CheatsText}" Click="Cheats_Click" ToolTip="Opens the Cheats page with this player picked." Visibility="{Binding IsPlayer, Converter={StaticResource Visible}}" Margin="0,0,6,6"/>
                                        <Button Style="{StaticResource Keep.Small}" Content="{Binding ItemsText}" ToolTip="{Binding ItemsTip}" Click="Items_Click" Visibility="{Binding IsItem, Converter={StaticResource Visible}}" Margin="0,0,6,6"/>
                                        <Button Style="{StaticResource Keep.Small}" Content="{Binding ShowOnMapText}" Click="Map_Click" ToolTip="Opens the Map page and shows where this is." Visibility="{Binding IsOnMap, Converter={StaticResource Visible}}" Margin="0,0,6,6"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" LineHeight="21" FontSize="13.5" Margin="0,14,0,0"
                                       Visibility="{Binding HasText, Converter={StaticResource Visible}}"/>
                            <TextBlock x:Name="ActionLine" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed"/>

                            <ItemsControl ItemsSource="{Binding Facts}" Margin="0,14,0,0">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Fact}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Label}" Foreground="{StaticResource Keep.TextDim}" FontSize="11"/>
                                                <TextBlock Text="{Binding Value}" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap" MaxWidth="320"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ItemsControl ItemsSource="{Binding Groups}" Margin="0,6,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,12">
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource Keep.H2}" FontSize="15" Margin="0,0,0,6"/>
                                            <ItemsControl ItemsSource="{Binding Links}">
                                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Style="{StaticResource Keep.Small}" Margin="0,0,6,6" Padding="10,5" Click="Link_Click" ToolTip="Opens this entry.">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                                                <TextBlock Text="{Binding Sub}" Foreground="{StaticResource Keep.TextDim}" FontSize="11.5" Margin="6,0,0,0" VerticalAlignment="Center"
                                                                           Visibility="{Binding HasSub, Converter={StaticResource Visible}}"/>
                                                            </StackPanel>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
