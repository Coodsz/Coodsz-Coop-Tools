<Window x:Class="CoodszHost.Keep.ItemsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Items" Width="1200" Height="800" MinWidth="980" MinHeight="600"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Foreground="{StaticResource Keep.TextMain}" FontFamily="Segoe UI">
    <!-- Items: give or take items. Category sidebar, search, sort, item cards and the basket. -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Visible"/>
        <Style TargetType="ScrollBar" BasedOn="{StaticResource Keep.ScrollBar}"/>
        <Geometry x:Key="Coin">M 6 1 A 5 5 0 1 0 6.01 1 M 6 3.5 L 6 8.5</Geometry>
    </Window.Resources>

    <Border Background="{StaticResource Keep.BgInput}" BorderBrush="{StaticResource Keep.Frame}" BorderThickness="1" Margin="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.6" Color="Black"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Margin="22,16,16,10" Background="Transparent" MouseLeftButtonDown="Header_MouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Items" Style="{StaticResource Keep.H1}"/>
                    <TextBlock Style="{StaticResource Keep.Dim}">
                        <Run Text="Target:"/>
                        <Run x:Name="TargetRun" Text="" Foreground="{StaticResource Keep.Accent}" FontWeight="SemiBold"/>
                    </TextBlock>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton x:Name="GiveMode" Style="{StaticResource Keep.Choice}" GroupName="ItemMode" Content="Give items" IsChecked="True" MinWidth="120" Checked="Mode_Checked" ToolTip="Pick items from every item in the game to give to the picked players."/>
                    <RadioButton x:Name="TakeMode" Style="{StaticResource Keep.Choice}" GroupName="ItemMode" Content="Take items" MinWidth="120" Checked="Mode_Checked" ToolTip="Pick items from the player's inventory to take away. Works on one player at a time."/>
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource Keep.Icon}" VerticalAlignment="Top" Margin="8,0,0,0" Click="Close_Click" ToolTip="Close">
                    <Path Data="{StaticResource Keep.IconClose}" Stroke="{StaticResource Keep.TextMain}" StrokeThickness="1.8" Width="16" Height="16"/>
                </Button>
            </Grid>

            <Grid Grid.Row="1" Margin="22,0,12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="210"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Categories -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,12,0">
                    <ItemsControl x:Name="Categories" Tag="coodsz:no-translate">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <RadioButton Style="{StaticResource Keep.Side}" GroupName="ItemCategory" Checked="Category_Checked" ToolTip="Shows only the items of this kind." Margin="0,0,0,1">
                                    <Grid>
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" Margin="0,0,30,0"/>
                                        <TextBlock Text="{Binding Count}" HorizontalAlignment="Right" FontSize="11.5" Foreground="{StaticResource Keep.TextFaint}"/>
                                    </Grid>
                                </RadioButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <!-- Search and per click -->
                    <Grid Margin="0,0,10,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SearchBox" Style="{StaticResource Keep.Text}" TextChanged="Search_Changed"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
                            <TextBlock Text="Per click" Style="{StaticResource Keep.Dim}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox x:Name="PerClickBox" Style="{StaticResource Keep.Text}" ToolTip="How many of an item one click on its card adds to the list." Width="64" Padding="4,7" Text="1" HorizontalContentAlignment="Center"/>
                            <Button Style="{StaticResource Keep.Button}" Content="&#x25B2;" Padding="10,6" Margin="4,0,0,0" FontSize="10" Tag="1" Click="PerClick_Click" ToolTip="Adds more items per click."/>
                            <Button Style="{StaticResource Keep.Button}" Content="&#x25BC;" Padding="10,6" Margin="4,0,0,0" FontSize="10" Tag="-1" Click="PerClick_Click" ToolTip="Adds fewer items per click."/>
                        </StackPanel>
                    </Grid>
                    <!-- Sort, wear filter and the count -->
                    <WrapPanel Grid.Row="1" Margin="0,0,10,10">
                        <TextBlock Text="Sort:" Style="{StaticResource Keep.Dim}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <RadioButton x:Name="SortCheapest" Style="{StaticResource Keep.Pill}" GroupName="ItemSort" Content="Cheapest" IsChecked="True" Checked="Filter_Changed" ToolTip="Shows the cheapest items first."/>
                        <RadioButton x:Name="SortExpensive" Style="{StaticResource Keep.Pill}" GroupName="ItemSort" Content="Most expensive" Checked="Filter_Changed" ToolTip="Shows the most expensive items first."/>
                        <RadioButton x:Name="SortTier" Style="{StaticResource Keep.Pill}" GroupName="ItemSort" Content="Tier" Checked="Filter_Changed" ToolTip="Sorts the items by tier."/>
                        <RadioButton x:Name="SortName" Style="{StaticResource Keep.Pill}" GroupName="ItemSort" Content="Name" Checked="Filter_Changed" ToolTip="Sorts the items by name."/>
                        <Border Width="1" Background="{StaticResource Keep.BorderDim}" Margin="6,3,12,3"/>
                        <RadioButton x:Name="WearAll" Style="{StaticResource Keep.Pill}" GroupName="ItemWear" Content="All" IsChecked="True" Checked="Filter_Changed" ToolTip="Shows civilian and battle items."/>
                        <RadioButton x:Name="WearCivilian" Style="{StaticResource Keep.Pill}" GroupName="ItemWear" Content="Civilian" Checked="Filter_Changed" ToolTip="Shows only civilian items."/>
                        <RadioButton x:Name="WearBattle" Style="{StaticResource Keep.Pill}" GroupName="ItemWear" Content="Battle" Checked="Filter_Changed" ToolTip="Shows only battle items."/>
                        <TextBlock x:Name="ResultText" Style="{StaticResource Keep.Dim}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </WrapPanel>
                    <Border x:Name="NoteBox" Grid.Row="2" Style="{StaticResource Keep.Note}" Margin="0,0,10,10" Visibility="Collapsed">
                        <TextBlock x:Name="NoteText" TextWrapping="Wrap"/>
                    </Border>
                    <!-- Cards -->
                    <ScrollViewer x:Name="CardScroll" Grid.Row="3" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="Cards" Tag="coodsz:no-translate">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource Keep.CardButton}" Width="150" Height="176" Margin="0,0,8,8" Click="Card_Click" ToolTip="{Binding Name}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="96"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            <Border Background="{StaticResource Keep.Picture}">
                                                <Grid>
                                                    <TextBlock Text="{Binding Stars}" Foreground="{StaticResource Keep.Accent}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Visibility="{Binding Image.NoImage, Converter={StaticResource Visible}}"/>
                                                    <Image Source="{Binding Image.Source}" Stretch="Uniform" Margin="6"/>
                                                    <Border Background="{StaticResource Keep.Badge}" CornerRadius="2" Padding="5,1" Margin="5" HorizontalAlignment="Left" VerticalAlignment="Top"
                                                            Visibility="{Binding IsCivilian, Converter={StaticResource Visible}}">
                                                        <TextBlock Text="{Binding CivilianText}" FontSize="10"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                            <StackPanel Grid.Row="1" Margin="8,6,8,6">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap" MaxHeight="32" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Culture}" FontSize="11" Foreground="{StaticResource Keep.TextDim}" Margin="0,3,0,0"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                                                    <Path Data="{StaticResource Coin}" Stroke="{StaticResource Keep.Accent}" StrokeThickness="1.3" Width="12" Height="12" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding ValueText}" FontSize="11.5" Foreground="{StaticResource Keep.AccentHover}" Margin="4,0,0,0"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <!-- Basket -->
            <Border Grid.Row="2" BorderBrush="{StaticResource Keep.BorderDim}" BorderThickness="0,1,0,0" Padding="22,10" Margin="0,8,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="BasketHint" Text="Click items to add them to the basket." Style="{StaticResource Keep.Dim}"/>
                        <ScrollViewer MaxHeight="64" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="Basket" Tag="coodsz:no-translate">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource Keep.BgRaised}" CornerRadius="2" Padding="10,2,4,2" Margin="0,0,6,4">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding CountText}" FontWeight="Bold" Foreground="{StaticResource Keep.Accent}" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Card.Name}" Margin="4,0,0,0" FontSize="12" VerticalAlignment="Center"/>
                                                <Button Style="{StaticResource Keep.Icon}" Padding="5,1" Margin="4,0,0,0" Click="RemoveLine_Click" ToolTip="Remove">
                                                    <Path Data="{StaticResource Keep.IconClose}" Stroke="{StaticResource Keep.TextDim}" StrokeThickness="1.6" Width="10" Height="10" Stretch="Uniform"/>
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="StatusText" Style="{StaticResource Keep.Dim}" VerticalAlignment="Center" Margin="0,0,14,0" MaxWidth="360" TextTrimming="CharacterEllipsis"/>
                        <Path Data="{StaticResource Coin}" Stroke="{StaticResource Keep.Accent}" StrokeThickness="1.3" Width="12" Height="12" VerticalAlignment="Center"/>
                        <TextBlock x:Name="BasketValue" Text="0" FontWeight="Bold" Margin="5,0,14,0" VerticalAlignment="Center"/>
                        <Button x:Name="GoldButton" Style="{StaticResource Keep.Button}" Content="Give value as gold" Margin="0,0,8,0" Click="GiveGold_Click"
                                ToolTip="Gives the basket's value as gold instead of the items"/>
                        <Button x:Name="ApplyButton" Style="{StaticResource Keep.Gold}" Content="Give items (0)" Click="Apply_Click" ToolTip="Gives or takes all the items in the list. The server confirms each one."/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
