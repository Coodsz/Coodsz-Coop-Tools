<UserControl x:Class="CoodszHost.Keep.MapPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:keep="clr-namespace:CoodszHost.Keep"
             Foreground="{StaticResource Keep.TextMain}" FontFamily="Segoe UI">
    <!--
        Map: the running campaign drawn from the server's data (coodsz.map). Settlements coloured by
        their kingdom, players highlighted, lords and armies, pan and zoom, a legend, and a side panel
        with the players, a search and the picked settlement or party. Read only.
    -->
    <UserControl.Resources>
        <Style TargetType="ScrollBar" BasedOn="{StaticResource Keep.ScrollBar}"/>
        <Style x:Key="Row" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource Keep.TextMain}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="2" Padding="8,5" Margin="0,0,0,1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Keep.BgRaised}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Keep.AccentSoft}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MapButton" TargetType="Button" BasedOn="{StaticResource Keep.Icon}">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Background" Value="{StaticResource Keep.BgPanel}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Keep.BorderDim}"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style x:Key="Fact" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Keep.BgRaised}"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Style="{StaticResource Keep.Panel}" HorizontalAlignment="Stretch" Margin="0,0,0,14">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Where everyone is in the running campaign, read from the server every few seconds. Nothing here changes the game." Style="{StaticResource Keep.Dim}" TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                <TextBlock x:Name="ReadText" Tag="coodsz:no-translate" Style="{StaticResource Keep.Dim}" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <Button x:Name="RefreshButton" Style="{StaticResource Keep.Button}" Click="Refresh_Click" ToolTip="Read the map from the server now. It also reads by itself every few seconds while this page is open.">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource Keep.IconRefresh}" Stroke="{StaticResource Keep.TextDim}" StrokeThickness="1.5" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Read now" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
        </Border>

        <!-- Stopped, starting, reading or could not read: one card instead of the map. -->
        <Border x:Name="StateCard" Grid.Row="1" Style="{StaticResource Keep.Card}" VerticalAlignment="Top" HorizontalAlignment="Left" MaxWidth="640" Padding="26,22">
            <StackPanel>
                <Path Data="{StaticResource Keep.IconInfo}" Stroke="{StaticResource Keep.Accent}" StrokeThickness="1.4" Width="22" Height="22" HorizontalAlignment="Left" Margin="0,0,0,12"/>
                <TextBlock x:Name="StateHeadline" Text="Start the server to see the map" Style="{StaticResource Keep.H2}" FontSize="20" TextWrapping="Wrap"/>
                <TextBlock x:Name="StateLine" Style="{StaticResource Keep.Dim}" TextWrapping="Wrap" Margin="0,6,0,0"
                           Text="The map shows the towns, castles and villages of the running campaign, who owns them, and where the players and lords are. Start the server and it fills in by itself."/>
                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                    <Button x:Name="StartButton" Style="{StaticResource Keep.Gold}" Padding="18,9" Click="Start_Click" ToolTip="Starts the server. The map fills in by itself once it is running.">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M 0 0 L 10 6 L 0 12 Z" Fill="{StaticResource Keep.OnAccent}" Width="10" Height="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Start server" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="TryAgainButton" Style="{StaticResource Keep.Button}" Content="Try again" Padding="16,9" Click="Refresh_Click" ToolTip="Reads the map from the server again." Visibility="Collapsed"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid x:Name="Browser" Grid.Row="1" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- The map, with its layer switches on a bar above it so nothing covers the names. -->
            <Border Style="{StaticResource Keep.Card}" Padding="0" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border BorderBrush="{StaticResource Keep.BorderDim}" BorderThickness="0,0,0,1" Padding="8,5">
                        <DockPanel>
                            <ToggleButton x:Name="LegendToggle" DockPanel.Dock="Right" Content="Kingdoms" FontSize="12" Padding="10,3" Cursor="Hand"
                                          Foreground="{StaticResource Keep.TextMain}" Click="Legend_Click" ToolTip="Show or hide the kingdoms and what the marks mean.">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bd" Background="{StaticResource Keep.BgRaised}" BorderBrush="{StaticResource Keep.BorderDim}" BorderThickness="1" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Keep.BgHover}"/>
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Keep.BorderHover}"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Keep.AccentSoft}"/>
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Keep.Accent}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <WrapPanel x:Name="Layers" VerticalAlignment="Center">
                                <CheckBox x:Name="TownsBox" ToolTip="Shows or hides the towns on the map." Style="{StaticResource Keep.Check}" FontSize="12" Content="Towns" IsChecked="True" Margin="0,0,6,0" Click="Layer_Click"/>
                                <CheckBox x:Name="CastlesBox" ToolTip="Shows or hides the castles on the map." Style="{StaticResource Keep.Check}" FontSize="12" Content="Castles" IsChecked="True" Margin="0,0,6,0" Click="Layer_Click"/>
                                <CheckBox x:Name="VillagesBox" ToolTip="Shows or hides the villages on the map." Style="{StaticResource Keep.Check}" FontSize="12" Content="Villages" IsChecked="True" Margin="0,0,6,0" Click="Layer_Click"/>
                                <CheckBox x:Name="ArmiesBox" ToolTip="Shows or hides the armies on the map. Players always show." Style="{StaticResource Keep.Check}" FontSize="12" Content="Armies" IsChecked="True" Margin="0,0,6,0" Click="Layer_Click"/>
                                <CheckBox x:Name="LordsBox" ToolTip="Shows or hides every lord's party on the map. Players always show." Style="{StaticResource Keep.Check}" FontSize="12" Content="Lords" IsChecked="False" Margin="0,0,6,0" Click="Layer_Click"/>
                                <CheckBox x:Name="TerritoryBox" ToolTip="Shows or hides the kingdom colours of the land." Style="{StaticResource Keep.Check}" FontSize="12" Content="Territory" IsChecked="True" Click="Layer_Click"/>
                            </WrapPanel>
                        </DockPanel>
                    </Border>
                    <Grid Grid.Row="1" ClipToBounds="True">
                    <keep:MapCanvas x:Name="Canvas"/>

                    <!-- Zoom -->
                    <StackPanel VerticalAlignment="Top" HorizontalAlignment="Right" Margin="8">
                        <Button Style="{StaticResource MapButton}" Click="ZoomIn_Click" ToolTip="Zoom in (or use the mouse wheel)">
                            <Path Data="M 1 6 L 11 6 M 6 1 L 6 11" Stroke="{StaticResource Keep.TextMain}" StrokeThickness="1.6" Width="12" Height="12"/>
                        </Button>
                        <Button Style="{StaticResource MapButton}" Click="ZoomOut_Click" ToolTip="Zoom out">
                            <Path Data="M 1 6 L 11 6" Stroke="{StaticResource Keep.TextMain}" StrokeThickness="1.6" Width="12" Height="12"/>
                        </Button>
                        <Button Style="{StaticResource MapButton}" Click="Fit_Click" ToolTip="Show the whole map">
                            <Path Data="M 1 4 L 1 1 L 4 1 M 8 1 L 11 1 L 11 4 M 11 8 L 11 11 L 8 11 M 4 11 L 1 11 L 1 8" Stroke="{StaticResource Keep.TextMain}" StrokeThickness="1.5" Width="12" Height="12"/>
                        </Button>
                    </StackPanel>

                    <!-- Legend: closed until Kingdoms on the bar opens it. -->
                    <Border x:Name="LegendCard" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,8,46,8" Padding="10,8" Background="#F2151D24" BorderBrush="{StaticResource Keep.BorderDim}" BorderThickness="1" Width="210" Visibility="Collapsed">
                        <StackPanel>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="220">
                                <ItemsControl x:Name="LegendList" Tag="coodsz:no-translate">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="11" Height="11" CornerRadius="2" Background="{Binding Brush}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="11.5" Foreground="{StaticResource Keep.TextMain}"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Fiefs}" FontSize="11" Foreground="{StaticResource Keep.TextFaint}" Margin="12,0,0,0"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <Border Height="1" Background="{StaticResource Keep.BorderDim}" Margin="0,6"/>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,1">
                                    <Path Data="M 6 0 L 7.4 4.1 L 12 4.6 L 8.5 7.4 L 9.6 12 L 6 9.5 L 2.4 12 L 3.5 7.4 L 0 4.6 L 4.6 4.1 Z" Fill="{StaticResource Keep.Accent}" Width="12" Height="12" Margin="0,0,7,0"/>
                                    <TextBlock Text="Player" FontSize="11" Foreground="{StaticResource Keep.TextDim}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,1">
                                    <Path Data="M 1 1 L 11 1 L 11 7 L 6 11 L 1 7 Z" Fill="{StaticResource Keep.TextDim}" Width="12" Height="12" Margin="0,0,7,0"/>
                                    <TextBlock Text="Town, castle or village" FontSize="11" Foreground="{StaticResource Keep.TextDim}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,1">
                                    <Path Data="M 6 1 L 11 6 L 6 11 L 1 6 Z" Fill="{StaticResource Keep.TextDim}" Width="12" Height="12" Margin="0,0,7,0"/>
                                    <TextBlock Text="Lord or army" FontSize="11" Foreground="{StaticResource Keep.TextDim}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,1">
                                    <Ellipse Stroke="{StaticResource Keep.Red}" StrokeThickness="1.6" Width="12" Height="12" Margin="0,0,7,0"/>
                                    <TextBlock Text="Battle or siege" FontSize="11" Foreground="{StaticResource Keep.TextDim}"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border x:Name="NoteCard" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="10,10,10,0" Padding="12,6" CornerRadius="2" Background="{StaticResource Keep.WarningSoft}" BorderBrush="{StaticResource Keep.Warning}" BorderThickness="1" Visibility="Collapsed">
                        <TextBlock x:Name="NoteText" Tag="coodsz:no-translate" FontSize="12" Foreground="{StaticResource Keep.Warning}" TextWrapping="Wrap" MaxWidth="520"/>
                    </Border>

                    <Border VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="8" Padding="6,1" Background="#C8151D24">
                        <TextBlock x:Name="ZoomText" Tag="coodsz:no-translate" FontSize="11" Foreground="{StaticResource Keep.TextDim}"/>
                    </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- Side panel -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Style="{StaticResource Keep.Card}" Padding="10">
                    <StackPanel>
                        <TextBox x:Name="SearchBox" Style="{StaticResource Keep.Text}" TextChanged="Search_Changed"/>
                        <ListBox x:Name="SearchList" Tag="coodsz:no-translate" Background="Transparent" BorderThickness="0" MaxHeight="190" Margin="0,6,0,0"
                                 ItemContainerStyle="{StaticResource Row}" SelectionChanged="Result_Selected" Visibility="Collapsed"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Tag}" Foreground="{StaticResource Keep.Accent}" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="NoMatch" Text="No match" Style="{StaticResource Keep.Dim}" Margin="4,8,4,2" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource Keep.Card}" Padding="10" Margin="0,12,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Margin="4,0,4,6">
                            <TextBlock x:Name="PlayerCount" DockPanel.Dock="Right" Tag="coodsz:no-translate" Style="{StaticResource Keep.Dim}" FontSize="11.5" VerticalAlignment="Center"/>
                            <TextBlock Text="Players" Style="{StaticResource Keep.H2}" FontSize="15"/>
                        </DockPanel>
                        <TextBlock Grid.Row="1" x:Name="NoPlayers" Text="No player party is on the map yet." Style="{StaticResource Keep.Dim}" TextWrapping="Wrap" Margin="4,0" Visibility="Collapsed"/>
                        <ListBox Grid.Row="1" x:Name="PlayerList" Tag="coodsz:no-translate" Background="Transparent" BorderThickness="0"
                                 ItemContainerStyle="{StaticResource Row}" SelectionChanged="Player_Selected"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Path Data="M 6 0 L 7.4 4.1 L 12 4.6 L 8.5 7.4 L 9.6 12 L 6 9.5 L 2.4 12 L 3.5 7.4 L 0 4.6 L 4.6 4.1 Z" Fill="{Binding Brush}" Stroke="{StaticResource Keep.Accent}" StrokeThickness="1" Width="12" Height="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Activity}" Foreground="{Binding ActivityBrush}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding Troops}" Foreground="{StaticResource Keep.TextDim}" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <!-- The picked settlement or party -->
                <Border Grid.Row="2" x:Name="Details" Style="{StaticResource Keep.Card}" Padding="14,12" Margin="0,12,0,0" Visibility="Collapsed">
                    <StackPanel Tag="coodsz:no-translate">
                        <TextBlock x:Name="DetailTitle" Style="{StaticResource Keep.H2}" FontSize="17" TextWrapping="Wrap"/>
                        <TextBlock x:Name="DetailSub" Style="{StaticResource Keep.Dim}" TextWrapping="Wrap" Margin="0,2,0,8"/>
                        <WrapPanel x:Name="DetailFacts"/>
                        <WrapPanel Margin="0,4,0,0">
                            <Button x:Name="CentreButton" ToolTip="Centres the map on the picked place or party and zooms in." Style="{StaticResource Keep.Small}" Click="Centre_Click" Margin="0,0,6,6"/>
                            <Button x:Name="ProfileButton" ToolTip="Opens the profile window of this player." Style="{StaticResource Keep.SmallGold}" Click="Profile_Click" Margin="0,0,6,6"/>
                            <Button x:Name="EncyclopediaButton" ToolTip="Opens this entry on the Encyclopedia page." Style="{StaticResource Keep.Small}" Click="Encyclopedia_Click" Margin="0,0,6,6"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

    </Grid>
</UserControl>
