<Window x:Class="CoodszHost.Keep.PlayerProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:keep="clr-namespace:CoodszHost.Keep"
        Title="Player profile" Width="1180" Height="800" MinWidth="960" MinHeight="600"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Foreground="{StaticResource Keep.TextMain}" FontFamily="Segoe UI">
    <!-- The player profile: header, stat tiles, Skills · Equipment · Inventory · Army, and quick actions. -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Visible"/>
        <Style TargetType="ScrollBar" BasedOn="{StaticResource Keep.ScrollBar}"/>
        <DataTemplate x:Key="GearTile">
            <Border Style="{StaticResource Keep.Tile}">
                <StackPanel>
                    <TextBlock Text="{Binding SlotName}" FontSize="10.5" Foreground="{StaticResource Keep.TextDim}" Margin="0,0,0,4"/>
                    <Border Height="82" CornerRadius="2" Background="{StaticResource Keep.Picture}" ClipToBounds="True">
                        <Grid>
                            <TextBlock Text="{Binding Name}" FontSize="10.5" Foreground="{StaticResource Keep.TextFaint}" TextWrapping="Wrap" TextAlignment="Center"
                                       VerticalAlignment="Center" Margin="6" Visibility="{Binding Image.NoImage, Converter={StaticResource Visible}}"/>
                            <Image Source="{Binding Image.Source}" Stretch="Uniform" Margin="2"/>
                        </Grid>
                    </Border>
                    <TextBlock Text="{Binding Name}" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0" MaxHeight="32" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="ArmyTile">
            <Border Style="{StaticResource Keep.Tile}">
                <StackPanel>
                    <Grid Height="96">
                        <Border CornerRadius="2" Background="{StaticResource Keep.Picture}" ClipToBounds="True">
                            <Grid>
                                <TextBlock Text="{Binding Stars}" Foreground="{StaticResource Keep.Accent}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="{Binding Image.NoImage, Converter={StaticResource Visible}}"/>
                                <Image Source="{Binding Image.Source}" Stretch="UniformToFill" VerticalAlignment="Top"/>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource Keep.CountBadge}">
                            <TextBlock Text="{Binding CountText}" FontSize="11" FontWeight="Bold"/>
                        </Border>
                    </Grid>
                    <TextBlock Text="{Binding Name}" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0" MaxHeight="32" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="InventoryTile">
            <Border Style="{StaticResource Keep.Tile}">
                <StackPanel>
                    <Grid Height="72">
                        <Border CornerRadius="2" Background="{StaticResource Keep.Picture}" ClipToBounds="True">
                            <Grid>
                                <TextBlock Text="{Binding Name}" FontSize="10.5" Foreground="{StaticResource Keep.TextFaint}" TextWrapping="Wrap" TextAlignment="Center"
                                           VerticalAlignment="Center" Margin="6" Visibility="{Binding Image.NoImage, Converter={StaticResource Visible}}"/>
                                <Image Source="{Binding Image.Source}" Stretch="Uniform" Margin="2"/>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource Keep.CountBadge}">
                            <TextBlock Text="{Binding CountText}" FontSize="11" FontWeight="Bold"/>
                        </Border>
                    </Grid>
                    <TextBlock Text="{Binding Name}" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0" MaxHeight="32" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>
        </DataTemplate>
        <ItemsPanelTemplate x:Key="Wrap"><WrapPanel/></ItemsPanelTemplate>
    </Window.Resources>

    <Border Background="{StaticResource Keep.BgInput}" BorderBrush="{StaticResource Keep.Frame}" BorderThickness="1" Margin="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.6" Color="Black"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Margin="22,18,16,8" Background="Transparent" MouseLeftButtonDown="Header_MouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid Width="54" Height="54">
                    <Border CornerRadius="2" Background="{StaticResource Keep.AccentSoft}" BorderBrush="{StaticResource Keep.Accent}" BorderThickness="1.5">
                        <TextBlock Text="{Binding Target.ShownInitial}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Keep.Accent}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Tag="coodsz:no-translate"/>
                    </Border>
                    <Border Width="14" Height="14" CornerRadius="7" Background="{StaticResource Keep.Success}" BorderBrush="{StaticResource Keep.BgPanel}" BorderThickness="2"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom" Visibility="{Binding Target.Online, Converter={StaticResource Visible}}"/>
                </Grid>
                <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Target.Shown}" Style="{StaticResource Keep.H1}" Tag="coodsz:no-translate"/>
                        <Border Background="{StaticResource Keep.SuccessSoft}" CornerRadius="2" Padding="8,1" Margin="10,0,0,0" VerticalAlignment="Center"
                                Visibility="{Binding Target.Online, Converter={StaticResource Visible}}">
                            <TextBlock Text="Online" FontSize="11" Foreground="{StaticResource Keep.Success}"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding SubLine}" Style="{StaticResource Keep.Dim}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" Tag="coodsz:no-translate"/>
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource Keep.Icon}" VerticalAlignment="Top" Margin="0,0,4,0" Click="Refresh_Click" ToolTip="Read again from the server">
                    <Path Data="{StaticResource Keep.IconRefresh}" Stroke="{StaticResource Keep.TextMain}" StrokeThickness="1.6" Width="16" Height="16"/>
                </Button>
                <Button Grid.Column="3" Style="{StaticResource Keep.Icon}" VerticalAlignment="Top" Click="Close_Click" ToolTip="Close">
                    <Path Data="{StaticResource Keep.IconClose}" Stroke="{StaticResource Keep.TextMain}" StrokeThickness="1.8" Width="16" Height="16"/>
                </Button>
            </Grid>

            <!-- Stat tiles -->
            <WrapPanel Grid.Row="1" Margin="22,4,22,4">
                <Border Style="{StaticResource Keep.Stat}"><StackPanel><TextBlock Text="Level" Style="{StaticResource Keep.Label}"/><TextBlock Text="{Binding LevelText}" Style="{StaticResource Keep.Value}"/></StackPanel></Border>
                <Border Style="{StaticResource Keep.Stat}"><StackPanel><TextBlock Text="Gold" Style="{StaticResource Keep.Label}"/><TextBlock Text="{Binding GoldText}" Style="{StaticResource Keep.Value}"/></StackPanel></Border>
                <Border Style="{StaticResource Keep.Stat}"><StackPanel><TextBlock Text="Health" Style="{StaticResource Keep.Label}"/><TextBlock Text="{Binding HealthText}" Style="{StaticResource Keep.Value}"/></StackPanel></Border>
                <Border Style="{StaticResource Keep.Stat}"><StackPanel><TextBlock Text="Age" Style="{StaticResource Keep.Label}"/><TextBlock Text="{Binding AgeText}" Style="{StaticResource Keep.Value}"/></StackPanel></Border>
                <Border Style="{StaticResource Keep.Stat}"><StackPanel><TextBlock Text="Influence" Style="{StaticResource Keep.Label}"/><TextBlock Text="{Binding InfluenceText}" Style="{StaticResource Keep.Value}"/></StackPanel></Border>
                <Border Style="{StaticResource Keep.Stat}"><StackPanel><TextBlock Text="Renown" Style="{StaticResource Keep.Label}"/><TextBlock Text="{Binding RenownText}" Style="{StaticResource Keep.Value}"/></StackPanel></Border>
                <Border Style="{StaticResource Keep.Stat}"><StackPanel><TextBlock Text="Army" Style="{StaticResource Keep.Label}"/><TextBlock Text="{Binding TroopsText}" Style="{StaticResource Keep.Value}"/></StackPanel></Border>
            </WrapPanel>

            <!-- Tabs and the note when nothing can be read -->
            <StackPanel Grid.Row="2" Margin="22,4,22,10">
                <Border Style="{StaticResource Keep.Note}" Margin="0,0,0,8" Visibility="{Binding HasNote, Converter={StaticResource Visible}}">
                    <TextBlock Text="{Binding Note}" TextWrapping="Wrap" FontSize="12.5"/>
                </Border>
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="TabSkills" Style="{StaticResource Keep.Choice}" GroupName="ProfileTab" Content="Skills" IsChecked="True" Checked="Tab_Checked" ToolTip="The hero's level, attributes and skills. You can change them here."/>
                    <RadioButton x:Name="TabGear" Style="{StaticResource Keep.Choice}" GroupName="ProfileTab" Content="Equipment" Checked="Tab_Checked" ToolTip="What the hero wears and carries into battle."/>
                    <RadioButton x:Name="TabInventory" Style="{StaticResource Keep.Choice}" GroupName="ProfileTab" Content="Inventory" Checked="Tab_Checked" ToolTip="The items in the hero's party inventory."/>
                    <RadioButton x:Name="TabArmy" Style="{StaticResource Keep.Choice}" GroupName="ProfileTab" Content="Army" Checked="Tab_Checked" ToolTip="The troops in the hero's party."/>
                    <TextBlock Text="Reading from the server..." Style="{StaticResource Keep.Dim}" VerticalAlignment="Center" Margin="12,0,0,0"
                               Visibility="{Binding Loading, Converter={StaticResource Visible}}"/>
                </StackPanel>
            </StackPanel>

            <!-- Content -->
            <ScrollViewer Grid.Row="3" Margin="22,0,12,0" Padding="0,0,10,0" VerticalScrollBarVisibility="Auto">
                <Grid>
                    <keep:SkillSheetView x:Name="SkillsPanel" DataContext="{Binding Sheet}"/>

                    <StackPanel x:Name="GearPanel" Visibility="Collapsed">
                        <TextBlock Text="No equipment was read. Press Refresh while the server runs." Style="{StaticResource Keep.Dim}"
                                   Visibility="{Binding NoGear, Converter={StaticResource Visible}}"/>
                        <TextBlock Text="Battle" Style="{StaticResource Keep.H2}" Margin="0,0,0,8" Visibility="{Binding HasGear, Converter={StaticResource Visible}}"/>
                        <ItemsControl ItemsSource="{Binding BattleGear}" ItemTemplate="{StaticResource GearTile}" ItemsPanel="{StaticResource Wrap}" Tag="coodsz:no-translate"/>
                        <TextBlock Text="Civilian" Style="{StaticResource Keep.H2}" Margin="0,8,0,8" Visibility="{Binding HasGear, Converter={StaticResource Visible}}"/>
                        <ItemsControl ItemsSource="{Binding CivilianGear}" ItemTemplate="{StaticResource GearTile}" ItemsPanel="{StaticResource Wrap}" Tag="coodsz:no-translate"/>
                    </StackPanel>

                    <StackPanel x:Name="InventoryPanel" Visibility="Collapsed">
                        <TextBlock Text="{Binding InventoryLine}" Style="{StaticResource Keep.Dim}" Margin="0,0,0,8"/>
                        <ItemsControl ItemsSource="{Binding Inventory}" ItemTemplate="{StaticResource InventoryTile}" ItemsPanel="{StaticResource Wrap}" Tag="coodsz:no-translate"/>
                    </StackPanel>

                    <StackPanel x:Name="ArmyPanel" Visibility="Collapsed">
                        <TextBlock Text="{Binding ArmyLine}" Style="{StaticResource Keep.Dim}" Margin="0,0,0,8"/>
                        <ItemsControl ItemsSource="{Binding Army}" ItemTemplate="{StaticResource ArmyTile}" ItemsPanel="{StaticResource Wrap}" Tag="coodsz:no-translate"/>
                        <TextBlock Text="Prisoners" Style="{StaticResource Keep.H2}" Margin="0,8,0,8" Visibility="{Binding HasPrisoners, Converter={StaticResource Visible}}"/>
                        <ItemsControl ItemsSource="{Binding Prisoners}" ItemTemplate="{StaticResource ArmyTile}" ItemsPanel="{StaticResource Wrap}" Tag="coodsz:no-translate"/>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- Quick actions -->
            <Border Grid.Row="4" BorderBrush="{StaticResource Keep.BorderDim}" BorderThickness="0,1,0,0" Padding="22,12" Margin="0,10,0,0">
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource Keep.Button}" Content="Open in Cheats" Margin="0,0,8,0" Click="OpenCheats_Click" ToolTip="Opens the Cheats page with this player picked and closes this window."/>
                    <Button Style="{StaticResource Keep.Button}" Content="Give/take items" Margin="0,0,8,0" Click="Items_Click" ToolTip="Opens the Items window to give items to this player or take items away."/>
                    <Button Style="{StaticResource Keep.Button}" Content="Show on map" Margin="0,0,8,0" Click="ShowOnMap_Click" ToolTip="Opens the Map page centred on this player's party"/>
                    <Border Width="1" Background="{StaticResource Keep.BorderDim}" Margin="4,2,12,2"/>
                    <Button Style="{StaticResource Keep.Danger}" Click="Ban_Click" ToolTip="Adds the player's SteamID64 to the ban list">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Keep.IconBan}" Stroke="#FFF3E0DC" StrokeThickness="1.5" Width="16" Height="16" Margin="0,0,6,0"/>
                            <TextBlock Text="Ban"/>
                        </StackPanel>
                    </Button>
                    <TextBlock Text="{Binding Status}" Style="{StaticResource Keep.Dim}" VerticalAlignment="Center" Margin="16,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="520"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
