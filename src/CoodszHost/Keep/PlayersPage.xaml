<UserControl x:Class="CoodszHost.Keep.PlayersPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{StaticResource Keep.TextMain}" FontFamily="Segoe UI">
    <!--
        Players: who is online (search, profile, Cheats, ban) and the Steam ban list the server reads
        (add SteamIDs, refresh, unban). The same lists and buttons the Server page had.
    -->
    <UserControl.Resources>
        <Style TargetType="ScrollBar" BasedOn="{StaticResource Keep.ScrollBar}"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,8,0">
            <Border Style="{StaticResource Keep.Panel}" Margin="0,0,0,14">
                <TextBlock Text="Who is on the server now, and who is banned." Style="{StaticResource Keep.Dim}"/>
            </Border>

            <Border Style="{StaticResource Keep.Card}" Padding="14,10" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Path Data="{StaticResource Keep.IconInfo}" Stroke="{StaticResource Keep.TextMain}" StrokeThickness="1.4" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="ServerLine" Text="The server is stopped. Start it to see connected players." TextWrapping="Wrap"/>
                        <TextBlock x:Name="StatusLine" Style="{StaticResource Keep.Dim}" TextWrapping="Wrap" Margin="0,2,0,0" Visibility="Collapsed"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <!-- Online -->
                <Border Style="{StaticResource Keep.Card}" VerticalAlignment="Top">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="OnlineTitle" Text="Online players: 0" Style="{StaticResource Keep.H2}" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" x:Name="SearchBox" Style="{StaticResource Keep.Text}" TextChanged="Search_Changed" Margin="8,0"/>
                            <Button Grid.Column="2" Style="{StaticResource Keep.Button}" Padding="7" Click="Refresh_Click" ToolTip="Read the players again">
                                <Path Data="{StaticResource Keep.IconRefresh}" Stroke="{StaticResource Keep.TextDim}" StrokeThickness="1.5" Width="16" Height="16"/>
                            </Button>
                        </Grid>
                        <TextBlock x:Name="NobodyText" Text="No players connected." Style="{StaticResource Keep.Dim}" FontSize="13"/>
                        <ItemsControl x:Name="PlayerList" Tag="coodsz:no-translate">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource Keep.BgRaised}" CornerRadius="2" Padding="10,8" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid Width="32" Height="32" Margin="0,0,12,0">
                                                <Border CornerRadius="2" Background="{StaticResource Keep.AccentSoft}" BorderBrush="{StaticResource Keep.Accent}" BorderThickness="1">
                                                    <TextBlock Text="{Binding Initial}" FontWeight="Bold" Foreground="{StaticResource Keep.Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <Border Width="9" Height="9" CornerRadius="4.5" Background="{StaticResource Keep.Success}" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                                            </Grid>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ShownName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding SteamLabel}" FontSize="11" Foreground="{StaticResource Keep.TextDim}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Style="{StaticResource Keep.Small}" Content="{Binding ProfileText}" Click="Profile_Click" ToolTip="{Binding ProfileTip}"/>
                                                <Button Style="{StaticResource Keep.Small}" Content="{Binding CheatsText}" Click="Cheats_Click" ToolTip="Opens the Cheats page with this player picked."/>
                                                <Button Style="{StaticResource Keep.Danger}" Padding="9,3" FontSize="12" Click="Ban_Click" ToolTip="Adds this player's SteamID64 to the server's ban list.">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Data="{StaticResource Keep.IconBan}" Stroke="#FFF3E0DC" StrokeThickness="1.4" Width="12" Height="12" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding BanText}"/>
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Banned -->
                <Border Grid.Column="2" Style="{StaticResource Keep.Card}" VerticalAlignment="Top">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="Banned players" Style="{StaticResource Keep.H2}" VerticalAlignment="Center"/>
                            <Path Data="{StaticResource Keep.IconBan}" Stroke="{StaticResource Keep.Red}" StrokeThickness="1.5" Width="16" Height="16" HorizontalAlignment="Right"/>
                        </Grid>
                        <TextBlock x:Name="BanStatus" Text="No banned players" Style="{StaticResource Keep.Dim}" FontSize="13" Margin="0,0,0,8"/>
                        <ItemsControl x:Name="BanList" Tag="coodsz:no-translate">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource Keep.BgRaised}" CornerRadius="2" Padding="10,6" Margin="0,0,0,6">
                                        <Grid>
                                            <TextBlock Text="{Binding Shown}" FontFamily="Consolas" VerticalAlignment="Center"/>
                                            <Button Style="{StaticResource Keep.Small}" Margin="0" HorizontalAlignment="Right" Content="{Binding UnbanText}" Click="Unban_Click" ToolTip="Takes this SteamID64 off the ban list."/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <WrapPanel Margin="0,8,0,0">
                            <Button Style="{StaticResource Keep.Button}" Content="Add SteamID" Click="AddBans_Click" Margin="0,0,8,6" ToolTip="Bans players who are not online, by SteamID64. One per line."/>
                            <Button Style="{StaticResource Keep.Button}" Content="Refresh bans" Click="RefreshBans_Click" ToolTip="Reads the ban list again." Margin="0,0,8,6"/>
                        </WrapPanel>
                        <TextBlock Text="The server reads this list of SteamID64s." Style="{StaticResource Keep.Dim}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
