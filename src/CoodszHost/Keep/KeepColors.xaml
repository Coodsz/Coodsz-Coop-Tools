<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        The colours of the Keep. styles (KeepTheme.xaml), in their own file. Every tool links this one file
        (the TAOM and Burning Empires server tools too since redesign wave 6); each tool's own accent comes from
        ToolAccent.Apply. App.xaml loads this file before KeepTheme.xaml.
    -->
    <!-- Window colours (MainWindow.xaml) -->
    <SolidColorBrush x:Key="Keep.BgDeep" Color="#FF0E1418"/>
    <SolidColorBrush x:Key="Keep.BgPanel" Color="#FF151D24"/>
    <SolidColorBrush x:Key="Keep.BgRaised" Color="#FF1B2833"/>
    <SolidColorBrush x:Key="Keep.BgHover" Color="#FF243646"/>
    <SolidColorBrush x:Key="Keep.BgInput" Color="#FF10161B"/>
    <SolidColorBrush x:Key="Keep.BorderDim" Color="#FF3A4C5C"/>
    <SolidColorBrush x:Key="Keep.BorderInput" Color="#FF2A3844"/>
    <SolidColorBrush x:Key="Keep.BorderHover" Color="#FFE2C27A"/>
    <SolidColorBrush x:Key="Keep.TextMain" Color="#FFD5DEE6"/>
    <SolidColorBrush x:Key="Keep.TextDim" Color="#FF8EA0AE"/>
    <SolidColorBrush x:Key="Keep.TextFaint" Color="#FF8EA0AE" Opacity="0.7"/>
    <!-- Selection is the selected nav button: dark blue with a light blue edge. -->
    <SolidColorBrush x:Key="Keep.Accent" Color="#FF8EB4D4"/>
    <SolidColorBrush x:Key="Keep.AccentHover" Color="#FFE2C27A"/>
    <SolidColorBrush x:Key="Keep.AccentSoft" Color="#FF1F4E79"/>
    <SolidColorBrush x:Key="Keep.OnAccent" Color="#FFD5DEE6"/>
    <SolidColorBrush x:Key="Keep.Success" Color="#FF8FCB9B"/>
    <SolidColorBrush x:Key="Keep.SuccessSoft" Color="#FF1E3326"/>
    <SolidColorBrush x:Key="Keep.Warning" Color="#FFE2C27A"/>
    <SolidColorBrush x:Key="Keep.WarningSoft" Color="#FF3A3420"/>
    <SolidColorBrush x:Key="Keep.Red" Color="#FFE2786C"/>
    <SolidColorBrush x:Key="Keep.RedSoft" Color="#FF4A2A28"/>
    <SolidColorBrush x:Key="Keep.Badge" Color="#CC000000"/>
    <SolidColorBrush x:Key="Keep.Picture" Color="#FF10161B"/>

    <!-- The Card style of the Server page. -->
    <SolidColorBrush x:Key="Keep.Frame" Color="#FF3A4C5C"/>
    <SolidColorBrush x:Key="Keep.PanelGradient" Color="#F0151D24"/>
    <!-- The Primary button (Save setup, Start server). -->
    <SolidColorBrush x:Key="Keep.GoldButton" Color="#FF1F4E79"/>
    <SolidColorBrush x:Key="Keep.GoldButtonHover" Color="#FF2A6294"/>
    <LinearGradientBrush x:Key="Keep.HealthBar" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FF8A4A4A" Offset="0"/>
        <GradientStop Color="#FFE2786C" Offset="1"/>
    </LinearGradientBrush>

    <!-- The window frame (sidebar, header, chips, banners), see docs/design/redesign/build-plan.md 1.2. These are the Coop Server Tool's. -->
    <SolidColorBrush x:Key="Keep.SidebarBack" Color="#FF0A1015"/>
    <SolidColorBrush x:Key="Keep.Line" Color="#FF2A3844"/>
    <SolidColorBrush x:Key="Keep.NavText" Color="#FFB8C6D1"/>
    <SolidColorBrush x:Key="Keep.NavSelected" Color="#FF17222B"/>
    <SolidColorBrush x:Key="Keep.NavSelectedLine" Color="#FF3A4C5C"/>
    <SolidColorBrush x:Key="Keep.GoldInk" Color="#FFE2C27A"/>
    <SolidColorBrush x:Key="Keep.Amber" Color="#FFE0A23A"/>
    <!-- Orange text (the Coodsz module chip of the side Mods card), light enough for 4.5:1 on the panels. -->
    <SolidColorBrush x:Key="Keep.OrangeInk" Color="#FFF08A4B"/>
    <!-- The line and words of an amber note (the Made for card). -->
    <SolidColorBrush x:Key="Keep.WarningLine" Color="#FF6B5C2E"/>
    <SolidColorBrush x:Key="Keep.WarningInk" Color="#FFF0D79A"/>
    <SolidColorBrush x:Key="Keep.AmberSoft" Color="#FF3A2E1A"/>
    <SolidColorBrush x:Key="Keep.InfoSoft" Color="#FF17263A"/>
    <SolidColorBrush x:Key="Keep.BadSoft" Color="#FF3A201C"/>
    <SolidColorBrush x:Key="Keep.FocusRing" Color="#FFE2C27A"/>
    <SolidColorBrush x:Key="Keep.GoFill" Color="#FF2F7D4F"/>
    <SolidColorBrush x:Key="Keep.GoFillHover" Color="#FF3A9160"/>
    <SolidColorBrush x:Key="Keep.StopFill" Color="#FFB83A2E"/>
    <SolidColorBrush x:Key="Keep.StopFillHover" Color="#FFCC4A3D"/>
    <!-- Join on Discord (Keep.BtnSolidGold), the Danger buttons and a link under the mouse. -->
    <SolidColorBrush x:Key="Keep.SolidFill" Color="#FFE2C27A"/>
    <SolidColorBrush x:Key="Keep.SolidFillHover" Color="#FFF3DC9A"/>
    <SolidColorBrush x:Key="Keep.OnSolid" Color="#FF0E1418"/>
    <SolidColorBrush x:Key="Keep.OnDanger" Color="#FFF3E0DC"/>
    <SolidColorBrush x:Key="Keep.DangerLine" Color="#FF6E3C38"/>
    <SolidColorBrush x:Key="Keep.DangerHover" Color="#FF5C3432"/>
    <SolidColorBrush x:Key="Keep.LinkHover" Color="#FFF3DC9A"/>
    <SolidColorBrush x:Key="Keep.RowHoverLine" Color="#FF3E5060"/>
    <!-- The tool's own colour from its icon's banner (ToolAccent.Apply sets both at start): the brand mark,
         the edge of the selected page button and the header badge only. A colour file with its own Keep.ToolEdge
         (the Realm of Thrones KeepColors.Rot.xaml) puts that on the selected page edge and the Join my server strip. -->
    <SolidColorBrush x:Key="Keep.ToolAccent" Color="#FF791F1F"/>
    <SolidColorBrush x:Key="Keep.ToolAccentInk" Color="#FFBC8F8F"/>

</ResourceDictionary>
